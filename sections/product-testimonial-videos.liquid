{% comment %}
  PDP: horizontal testimonial video carousel (Shopify-hosted videos).
  Add blocks in Theme editor → Product pages; same section shows on every product.
{% endcomment %}

{%- assign video_blocks = section.blocks | where: 'type', 'testimonial_video' -%}
{%- assign has_any_video = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'testimonial_video' and block.settings.video != blank -%}
    {%- assign has_any_video = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{% if has_any_video %}
{{ 'product-testimonial-videos.css' | asset_url | stylesheet_tag }}
<section
  class="pdp-testimonial-videos"
  id="shopify-section-{{ section.id }}"
  data-testimonial-videos-root
  {% if section.settings.heading != blank %}
    aria-labelledby="pdp-testimonial-videos-heading-{{ section.id }}"
  {% else %}
    aria-label="{{ section.settings.heading | default: 'Testimonial videos' | escape }}"
  {% endif %}
>
  <div class="pdp-testimonial-videos__inner">
    {% if section.settings.heading != blank %}
      <h2 class="pdp-testimonial-videos__heading" id="pdp-testimonial-videos-heading-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="pdp-testimonial-videos__subheading">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    <div
      class="pdp-testimonial-videos__wrap"
      id="pdp-testimonial-wrap-{{ section.id }}"
      data-tv-wrap
      data-section-id="{{ section.id }}"
    >
      <button
        type="button"
        class="pdp-testimonial-videos__arrow pdp-testimonial-videos__arrow--prev"
        data-tv-prev
        aria-controls="pdp-testimonial-scroll-{{ section.id }}"
        aria-label="Previous videos"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        class="pdp-testimonial-videos__arrow pdp-testimonial-videos__arrow--next"
        data-tv-next
        aria-controls="pdp-testimonial-scroll-{{ section.id }}"
        aria-label="Next videos"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="pdp-testimonial-videos__scroll"
        id="pdp-testimonial-scroll-{{ section.id }}"
        data-tv-scroll
        tabindex="-1"
        role="group"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading | default: 'Testimonial videos' | strip | escape }}"
      >
        <div class="pdp-testimonial-videos__track" data-tv-track>
          {% for block in video_blocks %}
            {% if block.settings.video == blank %}{% continue %}{% endif -%}
            {% assign vid = block.settings.video %}
            {% assign poster = block.settings.poster | default: vid.preview_image %}
            {% assign primary_url = '' %}
            {% assign primary_type = 'video/mp4' %}
            {% for source in vid.sources %}
              {% if source.mime_type == 'video/mp4' or source.format == 'mp4' %}
                {% assign primary_url = source.url %}
                {% assign primary_type = source.mime_type | default: 'video/mp4' %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% if primary_url == '' and vid.sources.size > 0 %}
              {% assign primary_url = vid.sources.first.url %}
              {% assign primary_type = vid.sources.first.mime_type | default: 'video/mp4' %}
            {% endif %}
            {% if primary_url == blank %}{% continue %}{% endif %}
            {% assign img_alt = block.settings.caption | default: section.settings.heading | default: 'Testimonial video' | strip %}
            {% assign poster_url = '' %}
            {% if poster != blank %}
              {% assign poster_url = poster | image_url: width: 560, format: 'webp' %}
            {% elsif vid.preview_image != blank %}
              {% assign poster_url = vid.preview_image | image_url: width: 560, format: 'webp' %}
            {% endif %}

            <div class="pdp-testimonial-videos__slide" {{ block.shopify_attributes }} data-tv-slide>
              <div class="pdp-testimonial-videos__card">
                <span class="pdp-testimonial-videos__media">
                  <video
                    class="pdp-testimonial-videos__inline-video"
                    data-tv-inline-video
                    data-tv-video-src="{{ primary_url | escape }}"
                    data-tv-video-type="{{ primary_type | escape }}"
                    muted
                    loop
                    playsinline
                    disablepictureinpicture
                    preload="none"
                    {% if poster_url != blank %}
                      poster="{{ poster_url }}"
                    {% endif %}
                    aria-label="{{ img_alt | escape }}"
                  ></video>
                  <span class="pdp-testimonial-videos__shade" aria-hidden="true"></span>
                  {% if block.settings.caption != blank %}
                    <span class="pdp-testimonial-videos__caption">{{ block.settings.caption | escape }}</span>
                  {% endif %}
                </span>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    function initTestimonialVideos(root) {
      if (root.getAttribute('data-tv-initialized') === 'true') return;
      root.setAttribute('data-tv-initialized', 'true');

      var scrollEl = root.querySelector('[data-tv-scroll]');
      var track = root.querySelector('[data-tv-track]');
      var prevBtn = root.querySelector('[data-tv-prev]');
      var nextBtn = root.querySelector('[data-tv-next]');
      var slides = track ? track.querySelectorAll('[data-tv-slide]') : [];

      if (!scrollEl || !track) return;

      var mqReduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');

      function getInlineVideos() {
        return root.querySelectorAll('[data-tv-inline-video]');
      }

      function prepareVideo(v) {
        v.muted = true;
        v.defaultMuted = true;
        v.playsInline = true;
        v.setAttribute('muted', '');
        v.setAttribute('playsinline', '');
        v.setAttribute('webkit-playsinline', '');
      }

      function attachVideoSource(v) {
        if (!v || v.getAttribute('data-tv-source-attached') === '1') return false;
        var src = v.getAttribute('data-tv-video-src');
        if (!src) return false;
        var source = document.createElement('source');
        source.src = src;
        source.type = v.getAttribute('data-tv-video-type') || 'video/mp4';
        v.appendChild(source);
        v.setAttribute('data-tv-source-attached', '1');
        return true;
      }

      function ensureVideoLoaded(v) {
        if (v.getAttribute('data-tv-loaded') === 'true') return;
        attachVideoSource(v);
        if (!v.querySelector('source')) return;
        v.setAttribute('data-tv-loaded', 'true');
        try {
          v.load();
        } catch (e) {}
      }

      function pauseVideo(v) {
        try {
          v.pause();
        } catch (e) {}
        v.classList.remove('is-playing');
      }

      function playVideo(v) {
        if (mqReduce && mqReduce.matches) {
          pauseVideo(v);
          return;
        }
        prepareVideo(v);
        attachVideoSource(v);
        if (!v.querySelector('source')) return;
        ensureVideoLoaded(v);

        function attemptPlay() {
          prepareVideo(v);
          try {
            var p = v.play();
            if (p && typeof p.then === 'function') {
              p.then(function() {
                v.classList.add('is-playing');
              }).catch(function() {
                window.setTimeout(function() {
                  if (!v.paused) return;
                  prepareVideo(v);
                  var retry = v.play();
                  if (retry && typeof retry.then === 'function') {
                    retry.then(function() {
                      v.classList.add('is-playing');
                    }).catch(function() {});
                  }
                }, 200);
              });
            } else {
              v.classList.add('is-playing');
            }
          } catch (e) {}
        }

        if (v.readyState >= 2) {
          attemptPlay();
        } else {
          v.addEventListener('loadeddata', attemptPlay, { once: true });
          v.addEventListener('canplay', attemptPlay, { once: true });
        }
      }

      function slideVisibilityRatio(slide) {
        var slideRect = slide.getBoundingClientRect();
        var scrollRect = scrollEl.getBoundingClientRect();
        var overlap = Math.min(slideRect.right, scrollRect.right) - Math.max(slideRect.left, scrollRect.left);
        if (overlap <= 0 || slideRect.width <= 0) return 0;
        return overlap / slideRect.width;
      }

      function syncPlaybackToVisibleSlides() {
        slides.forEach(function(slide) {
          var v = slide.querySelector('[data-tv-inline-video]');
          if (!v) return;
          if (slideVisibilityRatio(slide) >= 0.2) {
            playVideo(v);
          } else {
            pauseVideo(v);
          }
        });
      }

      function observeInlineVideos() {
        if (!('IntersectionObserver' in window)) {
          getInlineVideos().forEach(ensureVideoLoaded);
          syncPlaybackToVisibleSlides();
          return;
        }

        var sectionIo = new IntersectionObserver(
          function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                syncPlaybackToVisibleSlides();
              } else {
                getInlineVideos().forEach(pauseVideo);
              }
            });
          },
          { root: null, rootMargin: '120px', threshold: 0.01 }
        );
        sectionIo.observe(root);

        getInlineVideos().forEach(function(video) {
          video.addEventListener('loadeddata', syncPlaybackToVisibleSlides, { once: true });
        });
      }

      function getStep() {
        var slide = track.querySelector('[data-tv-slide]');
        if (!slide) return 200;
        var w = slide.offsetWidth;
        var cs = window.getComputedStyle(track);
        var gap = parseFloat(cs.columnGap || cs.gap) || 0;
        return w + gap;
      }

      function updateArrows() {
        var max = Math.max(0, scrollEl.scrollWidth - scrollEl.clientWidth - 1);
        var overflow = max > 2;
        if (prevBtn) {
          prevBtn.style.visibility = overflow ? '' : 'hidden';
          prevBtn.style.pointerEvents = overflow ? '' : 'none';
          prevBtn.tabIndex = overflow ? 0 : -1;
        }
        if (nextBtn) {
          nextBtn.style.visibility = overflow ? '' : 'hidden';
          nextBtn.style.pointerEvents = overflow ? '' : 'none';
          nextBtn.tabIndex = overflow ? 0 : -1;
        }
        if (!overflow) return;
        if (prevBtn) {
          var atStart = scrollEl.scrollLeft <= 2;
          prevBtn.disabled = atStart;
          prevBtn.setAttribute('aria-disabled', atStart ? 'true' : 'false');
        }
        if (nextBtn) {
          var atEnd = scrollEl.scrollLeft >= max - 1;
          nextBtn.disabled = atEnd;
          nextBtn.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
        }
      }

      function scrollByDir(dir) {
        var step = getStep();
        var max = Math.max(0, scrollEl.scrollWidth - scrollEl.clientWidth);
        var nextLeft = scrollEl.scrollLeft + dir * step;
        nextLeft = Math.max(0, Math.min(max, nextLeft));
        scrollEl.scrollTo({ left: nextLeft, behavior: mqReduce && mqReduce.matches ? 'auto' : 'smooth' });
      }

      function onArrowClick(e, dir) {
        e.preventDefault();
        e.stopPropagation();
        scrollByDir(dir);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          onArrowClick(e, -1);
          window.setTimeout(syncPlaybackToVisibleSlides, 80);
          window.setTimeout(syncPlaybackToVisibleSlides, 400);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          onArrowClick(e, 1);
          window.setTimeout(syncPlaybackToVisibleSlides, 80);
          window.setTimeout(syncPlaybackToVisibleSlides, 400);
        });
      }

      scrollEl.addEventListener(
        'scroll',
        function() {
          if (window.requestAnimationFrame) {
            window.requestAnimationFrame(function() {
              updateArrows();
              syncPlaybackToVisibleSlides();
            });
          } else {
            updateArrows();
            syncPlaybackToVisibleSlides();
          }
        },
        { passive: true }
      );

      window.addEventListener('resize', function() {
        updateArrows();
      });

      scrollEl.addEventListener(
        'wheel',
        function(e) {
          if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) e.preventDefault();
        },
        { passive: false }
      );

      getInlineVideos().forEach(function(video) {
        video.addEventListener('error', function() {
          video.setAttribute('data-tv-loaded', 'false');
          video.setAttribute('data-tv-source-attached', '0');
          video.querySelectorAll('source').forEach(function(s) {
            s.remove();
          });
          window.setTimeout(function() {
            syncPlaybackToVisibleSlides();
          }, 300);
        });
        video.addEventListener('click', function() {
          prepareVideo(video);
          attachVideoSource(video);
          ensureVideoLoaded(video);
          playVideo(video);
        });
      });

      observeInlineVideos();
      updateArrows();
      syncPlaybackToVisibleSlides();
      window.setTimeout(syncPlaybackToVisibleSlides, 300);
      window.setTimeout(syncPlaybackToVisibleSlides, 1000);
    }

    function boot() {
      document.querySelectorAll('[data-testimonial-videos-root]').forEach(initTestimonialVideos);
    }

    boot();

    if (!window.__sarvitalTestimonialVideosListeners) {
      window.__sarvitalTestimonialVideosListeners = true;

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      }

      document.addEventListener('shopify:section:load', function(event) {
        if (!event.target) return;
        var root = event.target.querySelector('[data-testimonial-videos-root]');
        if (root) initTestimonialVideos(root);
      });

      document.addEventListener('visibilitychange', function() {
        if (document.hidden) return;
        document.querySelectorAll('[data-testimonial-videos-root]').forEach(function(root) {
          if (root.getAttribute('data-tv-initialized') !== 'true') return;
          var scrollEl = root.querySelector('[data-tv-scroll]');
          if (!scrollEl) return;
          var slides = root.querySelectorAll('[data-tv-slide]');
          slides.forEach(function(slide) {
            var v = slide.querySelector('[data-tv-inline-video]');
            if (!v) return;
            try {
              if (v.paused) v.play();
            } catch (e) {}
          });
        });
      });
    }
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Testimonial videos",
  "tag": "section",
  "class": "section-product-testimonial-videos",
  "enabled_on": {
    "templates": ["product", "index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tried & trusted"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)",
      "default": "Real stories from people who use Sarvital."
    }
  ],
  "blocks": [
    {
      "type": "testimonial_video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Choose a video from your theme library (upload videos in Shopify admin: Content → Files)."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Custom poster (optional)",
          "info": "Overrides the automatic frame from Shopify."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Short label on thumbnail",
          "info": "Optional; keep to one line for best results."
        }
      ]
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "Testimonial videos",
      "settings": {
        "heading": "Tried & trusted",
        "subheading": "Real stories from people who use Sarvital."
      }
    }
  ]
}
{% endschema %}
