{% comment %}
  Home FAQ Section
  Displays FAQs from shop.metafields.custom.site_faqs.
  Supports: rich_text_field (use metafield_text for plain text) or multi-line text.
  Format: Q: Question text / A: Answer text (block-based parsing).
{% endcomment %}

{% capture faq_items_raw %}
  {% render 'faq-parse', faq_meta: shop.metafields.custom.site_faqs %}
{% endcapture %}
{% assign faq_items = '' | split: '' %}
{% assign faq_items_raw = faq_items_raw | strip %}
{% if faq_items_raw != blank %}
  {% assign faq_items = faq_items_raw | split: '###FAQ###' %}
{% endif %}

{% if faq_items.size > 0 %}
<section class="home-faq" id="home-faq" data-faq-section {{ section.shopify_attributes }}>
  <div class="home-faq__container">
    <div class="home-faq__header">
      <div class="home-faq__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
      <h2 class="home-faq__title">
        {%- if section.settings.title != blank -%}
          {{ section.settings.title | escape }}
        {%- else -%}
          {{ 'sections.home_faq.title' | t }}
        {%- endif -%}
      </h2>
    </div>

    <div class="home-faq__accordion">
      {% for item in faq_items %}
        {% assign qa_parts = item | split: '|||' %}
        {% assign question = qa_parts[0] | strip %}
        {% assign answer = qa_parts[1] | strip %}

        {% if question != blank %}
          <div class="home-faq-item" data-faq-index="{{ forloop.index0 }}">
            <h3 class="home-faq-item__question-heading">
              <button class="home-faq-item__button" type="button" aria-expanded="false" aria-controls="home-faq-answer-{{ section.id }}-{{ forloop.index0 }}">
                <span class="home-faq-item__question">{{ question | strip | escape }}</span>
                <span class="home-faq-item__icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 7.5l5 5 5-5"/>
                  </svg>
                </span>
              </button>
            </h3>
            <div class="home-faq-item__content" id="home-faq-answer-{{ section.id }}-{{ forloop.index0 }}" role="region">
              <div class="home-faq-item__answer">
                {% if answer != blank %}
                  {{ answer | strip | newline_to_br }}
                {% else %}
                  <p>No answer provided.</p>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_view_all_link %}
      <div class="home-faq__actions">
        <a href="{{ section.settings.view_all_url | default: '/pages/faq' }}" class="home-faq__view-all">
          {{ 'sections.home_faq.view_all' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

  {% render 'faq-schema', faq_items: faq_items %}
  {% render 'faq-accordion-styles' %}
  {% render 'faq-accordion-script' %}
{% endif %}

{% schema %}
{
  "name": "Home FAQ",
  "tag": "section",
  "class": "section-home-faq",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_link",
      "label": "Show link to full FAQ page",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Full FAQ page URL"
    }
  ],
  "presets": [
    {
      "name": "Home FAQ",
      "settings": {
        "title": "Frequently Asked Questions"
      }
    }
  ]
}
{% endschema %}
