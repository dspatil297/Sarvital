{% comment %}
  Product Reviews Section - Judge.me
{% endcomment %}

<section
  class="product-reviews-judge"
  id="product-reviews"
  data-hide-with-carousel="{% if section.settings.hide_with_carousel %}true{% else %}false{% endif %}"
>
  <div class="product-reviews-judge__container">
    <header class="product-reviews-judge__header">
      <h2 class="product-reviews-judge__title">Customer reviews</h2>
      <p class="product-reviews-judge__subtitle">Real feedback from verified buyers and product users.</p>
    </header>

    <div class="judge-me-shell">
      {% render 'judge-me-product-reviews', product: product %}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-reviews-judge {
    width: 100%;
    max-width: 100%;
    padding: 96px 40px;
    background:
      radial-gradient(circle at top right, rgba(74, 124, 44, 0.08) 0%, rgba(74, 124, 44, 0) 45%),
      var(--bg);
    box-sizing: border-box;
  }

  .product-reviews-judge__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-reviews-judge__header {
    text-align: center;
    margin-bottom: 30px;
  }

  .product-reviews-judge__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.8vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .product-reviews-judge__subtitle {
    margin: 10px 0 0;
    font-size: 1rem;
    line-height: 1.55;
    color: rgba(26, 26, 26, 0.72);
  }

  .judge-me-shell {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(247, 250, 244, 0.96));
    border-radius: 22px;
    padding: 28px;
    border: 1px solid rgba(74, 124, 44, 0.18);
    box-shadow: 0 16px 34px rgba(21, 33, 13, 0.08);
  }

  .judge-me-shell .jdgm-widget,
  .judge-me-shell .jdgm-review-widget,
  .judge-me-shell .jdgm-rev-widget {
    font-family: inherit;
  }

  .judge-me-shell .jdgm-rev-widget {
    padding: 0;
  }

  .judge-me-shell .jdgm-row-stars,
  .judge-me-shell .jdgm-histogram,
  .judge-me-shell .jdgm-rev-widg__summary {
    width: 100%;
    max-width: 100%;
  }

  .judge-me-shell .jdgm-rev-widg {
    margin: 0;
    border-radius: 16px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(74, 124, 44, 0.14);
  }

  .judge-me-shell .jdgm-rev__rating,
  .judge-me-shell .jdgm-star,
  .judge-me-shell .jdgm-star::before,
  .judge-me-shell .jdgm-star.jdgm--on {
    color: var(--sage-green) !important;
  }

  .judge-me-shell .jdgm-rev__author {
    font-weight: 600;
    color: var(--text);
  }

  .judge-me-shell .jdgm-rev__timestamp {
    color: rgba(26, 26, 26, 0.6);
    font-size: 0.84rem;
  }

  /* Native Judge.me carousel is used on product template — hide duplicate widget UI */
  .product-reviews-judge--carousel-mode:not(.product-reviews-judge--form-open):not(.product-reviews-judge--write-access) .judge-me-shell {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* Off-screen but functional so Judge.me can bind the write-review popup */
  .product-reviews-judge--carousel-mode.product-reviews-judge--write-access:not(.product-reviews-judge--form-open) .judge-me-shell {
    position: fixed;
    left: -10000px;
    top: 0;
    width: 420px;
    max-width: 100vw;
    height: auto;
    margin: 0;
    padding: 16px;
    overflow: visible;
    clip: auto;
    clip-path: none;
    white-space: normal;
    border: 0;
    opacity: 0.001;
    pointer-events: auto;
    z-index: 0;
  }

  .product-reviews-judge--review-modal-open {
    position: fixed;
    inset: 0;
    z-index: 10060;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 24px 16px;
    overflow-y: auto;
    background: rgba(26, 26, 26, 0.55);
  }

  .product-reviews-judge--review-modal-open .product-reviews-judge__container {
    width: 100%;
    max-width: 640px;
    margin: auto;
  }

  .product-reviews-judge--review-modal-open .product-reviews-judge__header {
    display: none;
  }

  .product-reviews-judge--review-modal-open .judge-me-shell {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    white-space: normal;
    opacity: 1;
    pointer-events: auto;
  }

  .product-reviews-judge--carousel-mode.product-reviews-judge--form-open .judge-me-shell {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    white-space: normal;
    opacity: 1;
    pointer-events: auto;
  }

  .product-reviews-judge--carousel-mode.product-reviews-judge--form-open #judgeme_product_reviews .jdgm-form,
  .product-reviews-judge--carousel-mode.product-reviews-judge--form-open #judgeme_product_reviews .jdgm-rev-widg__form {
    display: block !important;
    visibility: visible !important;
  }

  .product-reviews-judge--carousel-mode:not(.product-reviews-judge--form-open) {
    padding-top: 0;
    padding-bottom: 0;
    background: transparent;
  }

  .product-reviews-judge--carousel-mode.product-reviews-judge--form-open {
    padding: 32px 40px 64px;
    background:
      radial-gradient(circle at top right, rgba(74, 124, 44, 0.08) 0%, rgba(74, 124, 44, 0) 45%),
      var(--bg);
  }

  .product-reviews-judge--carousel-mode #judgeme_product_reviews .jdgm-rev-widg__summary,
  .product-reviews-judge--carousel-mode #judgeme_product_reviews .jdgm-histogram,
  .product-reviews-judge--carousel-mode #judgeme_product_reviews .jdgm-row-stars,
  .product-reviews-judge--carousel-mode #judgeme_product_reviews .jdgm-rev-widg__title,
  .product-reviews-judge--carousel-mode #judgeme_product_reviews .jdgm-rev-widg__reviews,
  .product-reviews-judge--carousel-mode #judgeme_product_reviews .jdgm-paginate,
  .product-reviews-judge--carousel-mode #judgeme_product_reviews .jdgm-rev {
    display: none !important;
  }

  .judge-me-shell .sarvital-reviews-carousel {
    position: relative;
    margin: 24px 0 8px;
    padding: 0 44px;
  }

  .judge-me-shell .sarvital-reviews-carousel__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .judge-me-shell .sarvital-reviews-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .judge-me-shell .jdgm-rev-widg__reviews {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    gap: 16px;
    margin: 0 !important;
    padding: 4px 0 12px !important;
    border: none !important;
  }

  .judge-me-shell .jdgm-rev-widg__reviews .jdgm-rev {
    flex: 0 0 min(320px, calc(100vw - 96px));
    scroll-snap-align: start;
    margin: 0 !important;
    padding: 16px !important;
    border: 1px solid rgba(74, 124, 44, 0.18) !important;
    border-radius: 12px !important;
    background: #ffffff !important;
    box-shadow: 0 8px 20px rgba(21, 33, 13, 0.06);
  }

  .judge-me-shell .sarvital-reviews-carousel__btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(74, 124, 44, 0.25);
    background: #ffffff;
    color: #2d5016;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .judge-me-shell .sarvital-reviews-carousel__btn--prev {
    left: 0;
  }

  .judge-me-shell .sarvital-reviews-carousel__btn--next {
    right: 0;
  }

  .judge-me-shell .jdgm-rev {
    margin: 0;
    padding: 22px 0;
    border-bottom: 1px solid rgba(74, 124, 44, 0.16);
  }

  .judge-me-shell .jdgm-rev:last-child {
    border-bottom: none;
  }

  .judge-me-shell .jdgm-rev__header {
    padding: 0;
    border-bottom: none;
    margin-bottom: 10px;
  }

  .judge-me-shell .jdgm-rev__title {
    margin: 0 0 8px;
    font-size: 1.04rem;
    line-height: 1.4;
    color: var(--text);
  }

  .judge-me-shell .jdgm-rev__body {
    padding: 0;
    color: rgba(26, 26, 26, 0.82);
    font-size: 0.98rem;
    line-height: 1.68;
  }

  .judge-me-shell .jdgm-paginate {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid rgba(74, 124, 44, 0.16);
  }

  .judge-me-shell .jdgm-paginate__page {
    color: var(--forest-green);
    border-color: rgba(74, 124, 44, 0.25);
    border-radius: 8px;
  }

  .judge-me-shell .jdgm-paginate__page:hover,
  .judge-me-shell .jdgm-paginate__page.jdgm-paginate__page--current {
    background: var(--forest-green);
    color: var(--white);
    border-color: var(--forest-green);
  }

  .judge-me-shell .jdgm-form {
    margin-top: 26px;
    padding-top: 26px;
    border-top: 1px solid rgba(74, 124, 44, 0.2);
  }

  .judge-me-shell .jdgm-form__title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 14px;
  }

  .judge-me-shell .jdgm-form__field input,
  .judge-me-shell .jdgm-form__field textarea {
    border: 1px solid rgba(74, 124, 44, 0.26);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .judge-me-shell .jdgm-form__field input:focus,
  .judge-me-shell .jdgm-form__field textarea:focus {
    border-color: var(--forest-green);
    outline: none;
    box-shadow: 0 0 0 3px rgba(74, 124, 44, 0.1);
  }

  .judge-me-shell .jdgm-form__submit,
  .judge-me-shell .jdgm-btn--solid,
  .judge-me-shell .jdgm-write-rev-link {
    background: linear-gradient(145deg, var(--forest-green), var(--sage-green)) !important;
    background-color: var(--forest-green) !important;
    border-color: var(--forest-green) !important;
    color: var(--white) !important;
    border-radius: 10px;
    padding: 12px 24px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .judge-me-shell .jdgm-form__submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 18px rgba(74, 124, 44, 0.25);
  }

  @media (max-width: 900px) {
    .product-reviews-judge {
      padding: 72px 24px;
    }

    .judge-me-shell {
      padding: 22px;
    }
  }

  @media (max-width: 768px) {
    .product-reviews-judge {
      padding: 58px 18px;
    }

    .product-reviews-judge__header {
      margin-bottom: 20px;
    }

    .judge-me-shell {
      padding: 16px;
      border-radius: 14px;
    }
  }

  @media (max-width: 480px) {
    .judge-me-shell .jdgm-rev-widg {
      padding: 12px;
    }

    .judge-me-shell .jdgm-rev {
      padding: 16px 0;
    }

    .judge-me-shell .jdgm-row-stars,
    .judge-me-shell .jdgm-histogram,
    .judge-me-shell .jdgm-histogram__bar-content {
      max-width: 100%;
      overflow-x: auto;
    }

    .judge-me-shell .jdgm-rev__body {
      font-size: 14px;
      line-height: 1.6;
      word-break: break-word;
      overflow-wrap: anywhere;
    }

    .judge-me-shell .jdgm-rev__author,
    .judge-me-shell .jdgm-rev__timestamp {
      font-size: 13px;
      line-height: 1.4;
    }

    .judge-me-shell .jdgm-rev__title {
      font-size: 15px;
      line-height: 1.4;
      word-break: break-word;
    }

    .judge-me-shell .jdgm-form {
      margin-top: 20px;
      padding-top: 20px;
    }

    .judge-me-shell .jdgm-form__title {
      font-size: 18px;
      margin-bottom: 12px;
    }

    .judge-me-shell .jdgm-form__field input,
    .judge-me-shell .jdgm-form__field textarea {
      font-size: 14px;
      padding: 10px 12px;
    }

    .judge-me-shell .jdgm-form__submit {
      width: 100%;
      padding: 12px 16px;
      text-align: center;
    }

    .judge-me-shell .jdgm-paginate {
      margin-top: 16px;
      padding-top: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews (Judge.me)",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_with_carousel",
      "label": "Hide review list when cards carousel is used",
      "default": true,
      "info": "When on and a Judge.me cards carousel is on this page, the review list below is hidden and Write a review appears on the carousel. Turn off to always show the full review widget."
    }
  ],
  "presets": [
    {
      "name": "Reviews (Judge.me)"
    }
  ]
}
{% endschema %}

