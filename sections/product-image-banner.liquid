{% comment %}
  Product Image Banner Section
  Displays the per-product "How to Use" image from the metafield:
    Namespace: custom
    Key:       pdp_how_to_use_img
    Type:      image (file_reference)
  Recommended image size: 1600×600 (8:3 ratio)
  Section renders nothing when the metafield is blank.
{% endcomment %}

{% assign how_to_use_img = product.metafields.custom.pdp_how_to_use_img.value %}

{% if how_to_use_img != blank %}
  <section class="product-image-banner" id="product-image-banner-{{ section.id }}">
    <div class="product-image-banner__container">
      <div class="product-image-banner__image-wrapper">
        <img
          class="product-image-banner__image"
          src="{{ how_to_use_img | image_url: width: 1600 }}"
          srcset="
            {{ how_to_use_img | image_url: width: 800 }} 800w,
            {{ how_to_use_img | image_url: width: 1200 }} 1200w,
            {{ how_to_use_img | image_url: width: 1600 }} 1600w
          "
          sizes="100vw"
          alt="{{ how_to_use_img.alt | default: 'How to use' }}"
          width="1600"
          height="600"
          loading="lazy"
        >
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .product-image-banner {
    width: 100%;
    max-width: 100%;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
  }

  .product-image-banner__container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .product-image-banner__image-wrapper {
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .product-image-banner__link {
    display: block;
    width: 100%;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .product-image-banner__link:hover {
    opacity: 0.95;
  }

  .product-image-banner__picture {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .product-image-banner__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.3s ease;
  }

  .product-image-banner__image.image-error {
    opacity: 0.5;
    background: rgba(245, 245, 245, 0.8);
  }

  .product-image-banner__placeholder {
    width: 100%;
    padding: 60px 20px;
    text-align: center;
    background: rgba(45, 80, 22, 0.05);
    border: 2px dashed rgba(74, 124, 44, 0.3);
    border-radius: 12px;
    color: var(--forest-green);
    font-size: 16px;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .product-image-banner {
      padding: 0;
      overflow-x: hidden;
      width: 100%;
      max-width: 100vw;
    }

    .product-image-banner__container {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    .product-image-banner__image-wrapper {
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    .product-image-banner__image {
      width: 100%;
      max-width: 100%;
      height: auto;
      object-fit: cover;
      object-position: center;
    }
  }

  @media (max-width: 480px) {
    .product-image-banner {
      overflow-x: hidden;
      width: 100%;
      max-width: 100vw;
    }

    .product-image-banner__image {
      width: 100%;
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image",
      "info": "Recommended size: 1920x600px or larger"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image (Optional)",
      "info": "Optional: Different image for mobile devices. Recommended size: 768x400px"
    },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "Image Alt Text",
      "default": "Product banner"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Link (Optional)",
      "info": "Optional: Make the banner clickable"
    }
  ],
  "presets": [
    {
      "name": "Product Image Banner"
    }
  ]
}
{% endschema %}
