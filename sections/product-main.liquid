    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
  }

  .pdp-description-shell__toggle:focus-visible {
    outline: 2px solid var(--forest-green);
    outline-offset: -2px;
  }

  .pdp-description-shell__toggle-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--forest-green);
    background: rgba(74, 124, 44, 0.12);
    flex-shrink: 0;
  }

  .pdp-description-shell__toggle-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
