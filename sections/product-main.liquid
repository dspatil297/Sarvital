<script>
  ;(function() {
    'use strict';
    // Product image gallery: carousel + thumbnails + zoom (inline script in product-hero markup)
    var variantButtons = document.querySelectorAll('.variant-option-btn');
    var variantSelect = document.getElementById('product-variant-select');
    var configEl = document.querySelector('#product-form [data-product-config]');
    var isGst5 = configEl && configEl.getAttribute('data-gst5') === 'true';
    var initialCart = {{ cart | json }};
    var productOptions = [];
    var productVariants = [];
    var selectedOptions = {};
    var defaultVariantId = null;
    var variantsDataEl = document.getElementById('product-variants-data');

    if (variantsDataEl) {
      try {
        var variantsPayload = JSON.parse(variantsDataEl.textContent);
        productOptions = variantsPayload.options || [];
        productVariants = variantsPayload.variants || [];
        defaultVariantId = variantsPayload.defaultVariantId;
      } catch (parseError) {
        productOptions = [];
        productVariants = [];
      }
    }

    function initSelectedOptionsFromButtons() {
      selectedOptions = {};
      var activeButtons = document.querySelectorAll('.variant-option-btn.active');
      for (var ai = 0; ai < activeButtons.length; ai++) {
        var activeBtn = activeButtons[ai];
        selectedOptions[activeBtn.getAttribute('data-option')] = activeBtn.getAttribute('data-value');
      }
    }

    function findMatchingVariant() {
      if (!productVariants.length) return null;
      return productVariants.find(function(variant) {
        for (var oi = 0; oi < productOptions.length; oi++) {
          var optionName = productOptions[oi];
          var optionKey = 'option' + (oi + 1);
          var selectedValue = selectedOptions[optionName];
          if (selectedValue && variant[optionKey] !== selectedValue) {
            return false;
          }
        }
        return true;
      }) || null;
    }

    function syncVariantButtonsWithVariant(variant) {
      if (!variant) return;
      for (var oi = 0; oi < productOptions.length; oi++) {
        var optionName = productOptions[oi];
        var optionValue = variant['option' + (oi + 1)];
        if (!optionValue) continue;
        var optionButtons = document.querySelectorAll('.variant-option-btn[data-option="' + optionName + '"]');
        for (var bi = 0; bi < optionButtons.length; bi++) {
          var optionBtn = optionButtons[bi];
          if (optionBtn.getAttribute('data-value') === optionValue) {
            optionBtn.classList.add('active');
          } else {
            optionBtn.classList.remove('active');
          }
        }
      }
    }

    function applyVariant(variant) {
      if (!variant || !variantSelect) return;
      variantSelect.value = String(variant.id);
      variantSelect.dispatchEvent(new Event('change'));
    }

    for (var bi = 0; bi < variantButtons.length; bi++) {
      (function(btn) {
        btn.addEventListener('click', function() {
          if (this.disabled) return;
          var option = this.getAttribute('data-option');
          var value = this.getAttribute('data-value');
          var sameOptionButtons = document.querySelectorAll('[data-option="' + option + '"]');
          for (var si = 0; si < sameOptionButtons.length; si++) sameOptionButtons[si].classList.remove('active');
          this.classList.add('active');
          selectedOptions[option] = value;
          var matchingVariant = findMatchingVariant();
          if (matchingVariant) {
            applyVariant(matchingVariant);
          }
        });
      })(variantButtons[bi]);
    }

    function getCurrentVariantIdFromForm() {
      if (!productForm) return null;
      var idInput = productForm.querySelector('input[name="id"], select[name="id"]');
      if (!idInput) return null;
      if (idInput.tagName === 'SELECT') return idInput.value || (idInput.options[idInput.selectedIndex] && idInput.options[idInput.selectedIndex].value);
      return idInput.value;
    }
    function syncProductFormWithInitialCart() {
      if (!productForm || !initialCart) return;
      var variantId = getCurrentVariantIdFromForm();
      if (!variantId) return;
      var qtyInput = productForm.querySelector('input[name="quantity"]');
      if (!qtyInput) return;
      var items = initialCart.items || [];
      var item = items.find(function(i) { return String(i.variant_id) === String(variantId) || String(i.id) === String(variantId); });
      if (item) {
        qtyInput.value = Math.min(Math.max(item.quantity, 1), parseInt(qtyInput.getAttribute('max'), 10) || 10);
        productForm.setAttribute('data-line-key', item.key);
        productForm.setAttribute('data-line-key-variant-id', String(variantId));
      } else {
        qtyInput.value = 1;
        productForm.removeAttribute('data-line-key');
        productForm.removeAttribute('data-line-key-variant-id');
      }
    }
    function syncProductFormWithCart() {
      if (!productForm) return;
      var variantId = getCurrentVariantIdFromForm();
      if (!variantId) return;
      var qtyInput = productForm.querySelector('input[name="quantity"]');
      if (!qtyInput) return;
      fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
        var items = cart.items || [];
        var item = items.find(function(i) { return String(i.variant_id) === String(variantId) || String(i.id) === String(variantId); });
        if (item) {
          qtyInput.value = Math.min(Math.max(item.quantity, 1), parseInt(qtyInput.getAttribute('max'), 10) || 10);
          productForm.setAttribute('data-line-key', item.key);
          productForm.setAttribute('data-line-key-variant-id', String(variantId));
        } else {
          qtyInput.value = 1;
          productForm.removeAttribute('data-line-key');
          productForm.removeAttribute('data-line-key-variant-id');
        }
      }).catch(function() {});
    }
    if (variantSelect) {
      variantSelect.addEventListener('change', function() {
        var selectedOption = this.options[this.selectedIndex];
        var price = selectedOption.getAttribute('data-price');
        var comparePrice = selectedOption.getAttribute('data-compare-price');
        var inventory = selectedOption.getAttribute('data-inventory');
        var selectedVariant = productVariants.find(function(variant) {
          return String(variant.id) === String(selectedOption.value);
        });
        if (selectedVariant) {
          price = String(selectedVariant.price);
          comparePrice = selectedVariant.compare_at_price ? String(selectedVariant.compare_at_price) : '';
          inventory = String(selectedVariant.inventory_quantity != null ? selectedVariant.inventory_quantity : inventory);
          syncVariantButtonsWithVariant(selectedVariant);
        }
        updatePriceDisplay(price, comparePrice);
        updateVariantContext(selectedVariant, selectedOption);
        var addToCartBtn = document.getElementById('add-to-cart-btn');
        var stickyBtn = document.getElementById('sticky-add-to-cart');
        if (selectedOption.disabled) {
          if (addToCartBtn) {
            addToCartBtn.disabled = true;
            var atcText = addToCartBtn.querySelector('.cta-button__text');
            if (atcText) atcText.textContent = 'Sold Out';
          }
          if (stickyBtn) stickyBtn.disabled = true;
        } else {
          if (addToCartBtn) {
            addToCartBtn.disabled = false;
            updateAtcButtonPrice(price);
          }
          if (stickyBtn) stickyBtn.disabled = false;
        }
        syncProductFormWithCart();
      });
    }
    document.addEventListener('cart:updated', syncProductFormWithCart);

    document.addEventListener('click', function(e) {
      var btn = e.target && e.target.closest ? e.target.closest('button.quantity-btn[data-action]') : null;
      if (!btn) return;
      var form = btn.closest('#product-form');
      if (!form) return;
      var selector = btn.closest('.quantity-selector');
      var quantityInput = selector ? selector.querySelector('input.quantity-input, input[name="quantity"]') : null;
      if (!quantityInput) return;
      e.preventDefault();
      var action = btn.getAttribute('data-action');
      var currentValue = parseInt(quantityInput.value, 10) || 1;
      var min = parseInt(quantityInput.getAttribute('min'), 10) || 1;
      var max = parseInt(quantityInput.getAttribute('max'), 10) || 10;
      if (action === 'increase' && currentValue < max) {
        quantityInput.value = currentValue + 1;
      } else if (action === 'decrease' && currentValue > min) {
        quantityInput.value = currentValue - 1;
      }
      var variantSelectEl = document.getElementById('product-variant-select');
      if (variantSelectEl) {
        var selectedOption = variantSelectEl.options[variantSelectEl.selectedIndex];
        if (selectedOption) updateAtcButtonPrice(selectedOption.getAttribute('data-price'));
      }
    });

    // AJAX Add to Cart: prevent full page submit, add via /cart/add.js, update header count and open cart drawer
    var productForm = document.getElementById('product-form');
    if (productForm) {
      productForm.addEventListener('submit', function(e) {
        var submitBtn = e.target.querySelector('button[type="submit"][name="add"]');
        var isSticky = e.submitter && e.submitter.id === 'sticky-add-to-cart';
        if (!submitBtn && !isSticky) return;
        var idInput = productForm.querySelector('input[name="id"], select[name="id"]');
        var qtyInput = productForm.querySelector('input[name="quantity"]');
        var variantId = idInput ? (idInput.value || (idInput.options && idInput.options[idInput.selectedIndex] && idInput.options[idInput.selectedIndex].value)) : null;
        var quantity = (qtyInput && parseInt(qtyInput.value, 10)) || 1;
        if (!variantId) return;
        e.preventDefault();
        var btn = isSticky ? e.submitter : submitBtn;
        var originalText = btn && btn.querySelector && btn.querySelector('.cta-button__text') ? btn.querySelector('.cta-button__text').textContent : btn.textContent;
        if (btn) {
          btn.disabled = true;
          if (btn.querySelector && btn.querySelector('.cta-button__text')) btn.querySelector('.cta-button__text').textContent = 'Adding...';
          else btn.textContent = 'Adding...';
        }
        var lineKey = productForm.getAttribute('data-line-key');
        var lineKeyVariantId = productForm.getAttribute('data-line-key-variant-id');
        var isUpdate = lineKey && lineKeyVariantId && String(lineKeyVariantId) === String(variantId);
        function done() {
          document.dispatchEvent(new CustomEvent('cart:updated'));
          syncProductFormWithCart();
        }
        function publishAddToCart() {
          try {
            if (window.Shopify && Shopify.analytics && typeof Shopify.analytics.publish === 'function') {
              Shopify.analytics.publish('product_added_to_cart', {
                cartLine: { quantity: quantity },
                productVariant: { id: variantId }
              });
            }
          } catch (e) {}
        }
        function fail(msg) {
          alert(msg || 'Could not add to cart. Please try again.');
        }
        function finishBtn() {
          if (btn) {
            btn.disabled = false;
            if (btn.querySelector && btn.querySelector('.cta-button__text')) btn.querySelector('.cta-button__text').textContent = originalText;
            else btn.textContent = originalText;
          }
        }
        if (isUpdate && quantity <= 0) {
          fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: lineKey, quantity: 0 }) })
            .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
            .then(function(result) {
              if (result.ok) { done(); productForm.removeAttribute('data-line-key'); productForm.removeAttribute('data-line-key-variant-id'); if (qtyInput) qtyInput.value = 1; }
              else fail(result.data && result.data.description || result.data && result.data.message);
            })
            .catch(function() { fail(); })
            .then(finishBtn);
        } else if (isUpdate) {
          fetch('/cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: lineKey, quantity: quantity }) })
            .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
            .then(function(result) {
              if (result.ok) done();
              else fail(result.data && result.data.description || result.data && result.data.message);
            })
            .catch(function() { fail(); })
            .then(finishBtn);
        } else {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: quantity })
          }).then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); }).then(function(result) {
            if (result.ok) { publishAddToCart(); done(); }
            else fail(result.data && result.data.message);
          }).catch(function() { fail(); }).then(finishBtn);
        }
      });
    }

    var buyNowBtn = document.getElementById('buy-now-btn');
    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function() {
        if (!productForm) return;
        var idInput = productForm.querySelector('input[name="id"], select[name="id"]');
        var qtyInput = productForm.querySelector('input[name="quantity"]');
        var variantId = idInput ? (idInput.value || (idInput.options && idInput.options[idInput.selectedIndex] && idInput.options[idInput.selectedIndex].value)) : null;
        var quantity = (qtyInput && parseInt(qtyInput.value, 10)) || 1;
        if (!variantId || quantity <= 0) return;
        var originalText = buyNowBtn.textContent;
        buyNowBtn.disabled = true;
        buyNowBtn.textContent = 'Processing...';
        var lineKey = productForm.getAttribute('data-line-key');
        var lineKeyVariantId = productForm.getAttribute('data-line-key-variant-id');
        var isUpdate = lineKey && lineKeyVariantId && String(lineKeyVariantId) === String(variantId);
        /** Standard Buy Now: redirect to Shopify checkout after adding to cart. */
        function goCheckout() {
          buyNowBtn.disabled = false;
          buyNowBtn.textContent = originalText;
          window.location.href = '/checkout';
        }
        function fail(msg) {
          alert(msg || 'Could not start checkout. Please try again.');
          buyNowBtn.disabled = false;
          buyNowBtn.textContent = originalText;
        }
        if (isUpdate) {
          fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: lineKey, quantity: quantity })
          }).then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); }).then(function(result) {
            if (result.ok) {
              goCheckout();
            } else {
              fail(result.data && (result.data.description || result.data.message));
            }
          }).catch(function() { fail(); });
        } else {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: quantity })
          }).then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); }).then(function(result) {
            if (result.ok) {
              goCheckout();
            } else {
              fail(result.data && result.data.message);
            }
          }).catch(function() { fail(); });
        }
      });
    }

    function updateAtcButtonPrice(priceCents) {
      var addToCartBtn = document.getElementById('add-to-cart-btn');
      if (!addToCartBtn || addToCartBtn.disabled) return;
      var qtyInput = document.querySelector('#product-form input[name="quantity"]');
      var qty = (qtyInput && parseInt(qtyInput.value, 10)) || 1;
      var unitPrice = parseInt(priceCents, 10) || 0;
      var atcText = addToCartBtn.querySelector('.cta-button__text');
      if (!atcText) return;
      atcText.innerHTML = 'Add to Cart — <span class="atc-price" id="atcPrice">' + formatMoney(unitPrice * qty) + '</span>';
    }

    function getUpgradeTextHtml(variantId) {
      if (variantId) {
        var variantTemplate = document.getElementById('upgrade-text-' + variantId);
        if (variantTemplate && variantTemplate.content) {
          var variantWrap = document.createElement('div');
          variantWrap.appendChild(variantTemplate.content.cloneNode(true));
          if (variantWrap.textContent.trim()) return variantWrap.innerHTML;
        }
      }
      var productTemplate = document.getElementById('upgrade-text-product');
      if (productTemplate && productTemplate.content) {
        var productWrap = document.createElement('div');
        productWrap.appendChild(productTemplate.content.cloneNode(true));
        if (productWrap.textContent.trim()) return productWrap.innerHTML;
      }
      return '';
    }

    function updateVariantContext(variant, selectedOption) {
      var explainerEl = document.getElementById('pgramExplainer');
      var variantId = variant && variant.id ? String(variant.id) : (selectedOption ? String(selectedOption.value) : '');
      var explainer = getUpgradeTextHtml(variantId);
      if (!explainerEl) return;
      if (explainer) {
        explainerEl.innerHTML = explainer;
        explainerEl.hidden = false;
        return;
      }
      if (explainerEl.getAttribute('data-fallback') === 'true') {
        explainerEl.innerHTML = '<strong>Good for trying {{ product.title | split: ' ' | first | escape }} for the first time.</strong><div class="info-tip">Most customers who start small come back for a larger pack within a few weeks.</div>';
        explainerEl.hidden = false;
        return;
      }
      explainerEl.hidden = true;
    }

    function updatePriceDisplay(price, comparePrice) {
      var priceSection = document.getElementById('product-price-block') || document.querySelector('.product-price-section');
      if (!priceSection) return;
      var gstNote = isGst5
        ? '<span class="price-gst-note">GST 5% for fruit and vegetables Dehydrated products.</span>'
        : '';
      var priceCents = parseInt(price, 10);
      var comparePriceCents = comparePrice ? parseInt(comparePrice, 10) : 0;
      var hasSale = comparePriceCents > priceCents;
      if (hasSale) {
        var savingsCents = comparePriceCents - priceCents;
        priceSection.innerHTML = '<div class="price-was" id="priceWas">MRP: ' + formatMoney(comparePriceCents) + '</div><div class="price-now"><div class="price-main" id="priceNow">' + formatMoney(priceCents) + '</div><span class="price-save-pill" id="priceSave">Save ' + formatMoney(savingsCents) + '</span></div><div class="price-note" id="priceNote">Incl. GST</div>' + gstNote;
      } else {
        priceSection.innerHTML = '<div class="price-now"><div class="price-main" id="priceNow">' + formatMoney(priceCents) + '</div></div><div class="price-note" id="priceNote">Incl. GST</div>' + gstNote;
      }

      var stickyPriceWrap = document.querySelector('.sticky-cart-bar__price');
      if (stickyPriceWrap) {
        var stickyOld = stickyPriceWrap.querySelector('.price-old');
        if (hasSale) {
          if (!stickyOld) {
            stickyOld = document.createElement('span');
            stickyOld.className = 'price-old';
            stickyPriceWrap.insertBefore(stickyOld, stickyPriceWrap.firstChild);
          }
          stickyOld.textContent = formatMoney(comparePriceCents);
          stickyOld.hidden = false;
        } else if (stickyOld) {
          stickyOld.hidden = true;
        }
        var stickyCurrent = stickyPriceWrap.querySelector('.price-current');
        if (stickyCurrent) {
          stickyCurrent.textContent = formatMoney(priceCents);
        }
      }

    }

    function updateStockAlert(inventory) {
      var stockAlert = document.querySelector('.product-stock-alert');
      var stockAvailable = document.querySelector('.product-stock-available');
      if (stockAlert) stockAlert.remove();
      if (stockAvailable) stockAvailable.remove();
      var inventoryNum = parseInt(inventory, 10) || 0;
      var productInfo = document.querySelector('.product-info');
      if (inventoryNum > 0 && inventoryNum <= 10) {
        var alert = document.createElement('div');
        alert.className = 'product-stock-alert';
        alert.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span>Only ' + inventoryNum + ' left in stock!</span>';
        var priceSection = document.querySelector('.product-price-section');
        if (priceSection && priceSection.nextSibling) {
          productInfo.insertBefore(alert, priceSection.nextSibling);
        }
      } else if (inventoryNum > 10) {
        var available = document.createElement('div');
        available.className = 'product-stock-available';
        available.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span>Limited Stock</span>';
        var priceSection = document.querySelector('.product-price-section');
        if (priceSection && priceSection.nextSibling) {
          productInfo.insertBefore(available, priceSection.nextSibling);
        }
      }
    }

    function formatMoney(cents) {
      var currencySymbol = (configEl && configEl.getAttribute('data-currency')) || '₹';
      var amount = (parseInt(cents, 10) / 100).toFixed(2);
      return currencySymbol + amount;
    }

    // Initialize on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function applyDefaultVariantOnLoad() {
      if (!variantSelect || !defaultVariantId) return;
      if (window.location.search.indexOf('variant=') !== -1) return;
      variantSelect.value = String(defaultVariantId);
      var defaultVariant = productVariants.find(function(variant) {
        return String(variant.id) === String(defaultVariantId);
      });
      if (defaultVariant) {
        syncVariantButtonsWithVariant(defaultVariant);
      }
    }

    function init() {
      if (variantSelect) {
        applyDefaultVariantOnLoad();
        initSelectedOptionsFromButtons();
        variantSelect.dispatchEvent(new Event('change'));
      }
      // Sync quantity with cart (show existing cart qty for this variant)
      syncProductFormWithInitialCart();
      // Then refresh from latest AJAX cart (in case cart changed after page render)
      syncProductFormWithCart();
      initDescriptionToggle();
    }

    function initDescriptionToggle() {
      var toggleButton = document.getElementById('pdp-description-toggle');
      var panel = document.getElementById('pdp-description-panel');
      var actionText = toggleButton ? toggleButton.querySelector('.pdp-description-shell__toggle-action') : null;
      if (!toggleButton || !panel) return;
      function setExpanded(isExpanded) {
        toggleButton.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        panel.hidden = !isExpanded;
        if (actionText) actionText.textContent = isExpanded ? 'Hide detail' : 'View detail';
      }
      setExpanded(toggleButton.getAttribute('aria-expanded') === 'true');
      toggleButton.addEventListener('click', function() {
        var expanded = toggleButton.getAttribute('aria-expanded') === 'true';
        setExpanded(!expanded);
      });
    }
  })();
</script>

