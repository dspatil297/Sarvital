{% comment %}
  Product Main Section - Conversion-Optimized Design
  Designed for maximum conversions with above-fold CTA, social proof, trust signals
{% endcomment %}

{% liquid
  assign pdp_variant = product.selected_or_first_available_variant
  assign recommended_variant = nil
  assign recommended_option_value = section.settings.recommended_option_value

  if recommended_option_value == blank
    assign recommended_option_value = product.metafields.custom.recommended_option_value.value
  endif
  if recommended_option_value == blank
    assign recommended_option_value = product.metafields.custom.recommended_option_value
  endif

  for variant in product.variants
    assign recommended_flag = variant.metafields.custom.variant_recommended.value
    if recommended_flag == blank
      assign recommended_flag = variant.metafields.custom.variant_recommended
    endif
    if recommended_flag == true
      assign recommended_variant = variant
      break
    endif
  endfor

  if recommended_variant == blank
    assign recommended_ref = product.metafields.custom.recommended_variant.value
    if recommended_ref == blank
      assign recommended_ref = product.metafields.custom.recommended_variant
    endif
    if recommended_ref != blank
      assign recommended_variant = recommended_ref
    endif
  endif

  if recommended_variant == blank
    if recommended_option_value != blank
      assign recommended_variant = product.variants | where: 'option1', recommended_option_value | first
      if recommended_variant == blank
        assign recommended_variant = product.variants | where: 'option2', recommended_option_value | first
      endif
      if recommended_variant == blank
        assign recommended_variant = product.variants | where: 'option3', recommended_option_value | first
      endif
    endif
  endif

  if product.selected_variant
    assign pdp_variant = product.selected_variant
  elsif recommended_variant != blank
    if recommended_variant.available
      assign pdp_variant = recommended_variant
    endif
  endif

  assign pdp_upgrade_field = pdp_variant.metafields.custom.upgradetext
  assign pdp_upgrade_plain = pdp_upgrade_field | metafield_text | strip
  if pdp_upgrade_plain == blank
    assign pdp_upgrade_field = product.metafields.custom.upgradetext
    assign pdp_upgrade_plain = pdp_upgrade_field | metafield_text | strip
  endif
  assign pdp_has_upgrade_text = false
  if pdp_upgrade_plain != blank
    assign pdp_has_upgrade_text = true
  endif
%}

<style>
  html:has(body.template-product),
  body.template-product {
    overflow-x: clip;
  }

  body.template-product #main-content,
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .product-hero {
    overflow: visible !important;
  }
</style>

<section class="product-hero" id="product-hero">
  <div class="product-hero__container">
    <!-- Left Column - Product Images (static gallery like reference PDP) -->
    <div class="product-gallery">
      {% if product.featured_image or product.images.size > 0 %}
        {% liquid
          assign gallery_first = product.featured_image | default: product.images.first
        %}
        <div class="product-image-main" id="product-gallery-main">
          <img
            id="product-main-img"
            src="{{ gallery_first | image_url: width: 900, format: 'webp' }}"
            srcset="
              {{ gallery_first | image_url: width: 300, format: 'webp' }} 300w,
              {{ gallery_first | image_url: width: 600, format: 'webp' }} 600w,
              {{ gallery_first | image_url: width: 900, format: 'webp' }} 900w,
              {{ gallery_first | image_url: width: 1200, format: 'webp' }} 1200w
            "
            sizes="(max-width: 900px) 100%, 640px"
            alt="{{ gallery_first.alt | default: product.title }}"
            class="product-image-main__img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="900"
            height="900"
            onerror="this.classList.add('image-error'); this.alt='Product image failed to load';"
          >
          {% if section.settings.show_promo_badge %}
            <div class="gallery-badge gallery-badge--promo" id="product-promo-badge">{{ section.settings.promo_badge_text | default: '🎁 Rakhi Special' }}</div>
          {% endif %}
        </div>
        {% if product.images.size > 1 %}
          <div class="product-thumbnails-wrap">
            <button
              type="button"
              class="product-thumbnails-nav product-thumbnails-prev"
              id="product-thumbnails-prev"
              aria-label="{{ 'products.media.previous_image' | t }}"
              hidden
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div
              class="product-thumbnails"
              id="product-thumbnails-container"
              role="tablist"
              aria-label="{{ 'products.media.gallery' | t }}"
            >
              {% for image in product.images %}
                <button
                  type="button"
                  class="product-thumbnail{% if image.id == gallery_first.id %} is-active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-src="{{ image | image_url: width: 900, format: 'webp' }}"
                  data-srcset="{{ image | image_url: width: 300, format: 'webp' }} 300w, {{ image | image_url: width: 600, format: 'webp' }} 600w, {{ image | image_url: width: 900, format: 'webp' }} 900w, {{ image | image_url: width: 1200, format: 'webp' }} 1200w"
                  data-alt="{{ image.alt | default: product.title | escape }}"
                  role="tab"
                  aria-selected="{% if image.id == gallery_first.id %}true{% else %}false{% endif %}"
                  id="product-thumbnail-{{ forloop.index0 }}"
                  aria-label="{{ 'products.media.load_image' | t: index: forloop.index, count: product.images.size }}"
                >
                  {%- liquid
                    assign thumb_src = image | image_url: width: 144, format: 'webp'
                    assign thumb_loading = 'eager'
                    if forloop.index > 6
                      assign thumb_loading = 'lazy'
                    endif
                  -%}
                  <img
                    class="product-thumbnail__img"
                    src="{{ thumb_src }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    width="72"
                    height="72"
                    loading="{{ thumb_loading }}"
                    decoding="async"
                    {% if forloop.index <= 3 %}fetchpriority="high"{% endif %}
                  >
                </button>
              {% endfor %}
            </div>
            <button
              type="button"
              class="product-thumbnails-nav product-thumbnails-next"
              id="product-thumbnails-next"
              aria-label="{{ 'products.media.next_image' | t }}"
              hidden
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        {% endif %}
        <script>
          (function() {
            var mainImg = document.getElementById('product-main-img');
            var thumbsEl = document.getElementById('product-thumbnails-container');
            var thumbsPrev = document.getElementById('product-thumbnails-prev');
            var thumbsNext = document.getElementById('product-thumbnails-next');
            if (!mainImg) return;

            var current = 0;
            var thumbs = thumbsEl ? thumbsEl.querySelectorAll('.product-thumbnail') : [];

            function scrollThumbIntoView(index) {
              if (!thumbsEl || !thumbs[index]) return;
              thumbs[index].scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
            }

            function updateThumbNav() {
              if (!thumbsEl) return;
              var hasOverflow = thumbsEl.scrollWidth > thumbsEl.clientWidth + 1;
              if (thumbsPrev) thumbsPrev.hidden = !hasOverflow;
              if (thumbsNext) thumbsNext.hidden = !hasOverflow;
            }

            function scrollThumbsBy(direction) {
              if (!thumbsEl) return;
              var step = 80;
              thumbsEl.scrollBy({ left: direction * step, behavior: 'smooth' });
            }

            function goTo(index) {
              if (!thumbs.length) return;
              current = Math.max(0, Math.min(index, thumbs.length - 1));
              var thumb = thumbs[current];
              var src = thumb.getAttribute('data-src') || thumb.getAttribute('data-full-src');
              var srcset = thumb.getAttribute('data-srcset');
              var alt = thumb.getAttribute('data-alt');
              if (src) {
                mainImg.src = src;
              }
              if (srcset) {
                mainImg.srcset = srcset;
              } else {
                mainImg.removeAttribute('srcset');
              }
              if (alt) mainImg.alt = alt;
              for (var i = 0; i < thumbs.length; i++) {
                var isActive = i === current;
                thumbs[i].classList.toggle('is-active', isActive);
                thumbs[i].setAttribute('aria-selected', isActive ? 'true' : 'false');
              }
              scrollThumbIntoView(current);
            }

            for (var tb = 0; tb < thumbs.length; tb++) {
              (function(ix, thumbBtn) {
                thumbBtn.addEventListener('click', function(e) {
                  if (e) e.preventDefault();
                  goTo(ix);
                });
                var preloadSrc = thumbBtn.getAttribute('data-src');
                if (preloadSrc) {
                  thumbBtn.addEventListener('mouseenter', function() {
                    if (thumbBtn.getAttribute('data-main-preloaded') === 'true') return;
                    var img = new Image();
                    img.src = preloadSrc;
                    thumbBtn.setAttribute('data-main-preloaded', 'true');
                  }, { once: true });
                }
              })(tb, thumbs[tb]);
            }

            if (thumbsPrev) {
              thumbsPrev.addEventListener('click', function() { scrollThumbsBy(-1); });
            }
            if (thumbsNext) {
              thumbsNext.addEventListener('click', function() { scrollThumbsBy(1); });
            }
            if (thumbsEl) {
              thumbsEl.addEventListener('scroll', updateThumbNav, { passive: true });
              window.addEventListener('resize', updateThumbNav);
              updateThumbNav();
            }

            for (var pi = 0; pi < thumbs.length && pi < 4; pi++) {
              var preloadMainSrc = thumbs[pi].getAttribute('data-src');
              if (preloadMainSrc) {
                (new Image()).src = preloadMainSrc;
              }
            }

            window.productImageGallery = {
              goTo: goTo,
              getCurrent: function() { return current; }
            };
          })();
        </script>
      {% else %}
        <div class="product-image-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        </div>
      {% endif %}
    </div>
    
    <!-- Right Column - Product Info & CTA -->
    <div class="product-info fade-in-up" style="animation-delay: 0.2s;">
      <div class="product-trust-badges">
        <span class="trust-badge trust-badge--shipping">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M1 3h15v13H1V3zm16 8h4l3 3v4h-7v-7z"/>
            <path d="M5 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4zm12 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
          </svg>
          Free Shipping Above ₹499
        </span>
        {% if section.settings.show_promo_badge %}
          <span class="trust-badge trust-badge--high-demand">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            {{ section.settings.offer_tag_text | default: 'Rakshabandhan Sale' }}
          </span>
        {% endif %}
        {% liquid
          assign certificates = product.metafields.custom.certificates.value
          if certificates == blank
            assign certificates = product.metafields.custom.certificates
          endif
          assign high_demand = product.metafields.custom.high_demand.value
          if high_demand == blank
            assign high_demand = product.metafields.custom.high_demand
          endif
        %}
        {% if certificates != blank %}
          <span class="trust-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
            {{ certificates }}
          </span>
        {% endif %}
        {% if high_demand == true %}
          <span class="trust-badge trust-badge--high-demand">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
            High Demand Alert
          </span>
        {% endif %}
      </div>

      <h1 class="product-title">{{ product.title }}</h1>

      <div class="product-rating-summary">
        <div class="rating-stars">
          {% assign avg_rating = 4.8 %}
          {% assign review_count = 127 %}
          {% assign rating_floor = avg_rating | floor %}
          {% assign next_star = rating_floor | plus: 1 %}
          {% assign rating_decimal = avg_rating | minus: rating_floor %}
          {% for i in (1..5) %}
            {% if i <= rating_floor %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="star-filled">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
              </svg>
            {% elsif i == next_star and rating_decimal >= 0.5 %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="star-half">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
              </svg>
            {% else %}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="star-empty">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
              </svg>
            {% endif %}
          {% endfor %}
        </div>
        <span class="rating-text">
          <strong>{{ avg_rating }}</strong>
          <a href="#product-reviews" class="rating-link">({{ review_count }} reviews)</a>
        </span>
      </div>

      <div class="product-price-section price-block" id="product-price-block">
        {% if pdp_variant.compare_at_price > pdp_variant.price %}
          <div class="price-was" id="priceWas">MRP: {{ pdp_variant.compare_at_price | money }}</div>
          <div class="price-now">
            <div class="price-main" id="priceNow">{{ pdp_variant.price | money }}</div>
            <span class="price-save-pill" id="priceSave">Save {{ pdp_variant.compare_at_price | minus: pdp_variant.price | money }}</span>
          </div>
        {% else %}
          <div class="price-now">
            <div class="price-main" id="priceNow">{{ pdp_variant.price | money }}</div>
          </div>
        {% endif %}
        <div class="price-note" id="priceNote">
          Incl. GST
        </div>
        {% if product.tags contains 'gst-5' %}
          <span class="price-gst-note">GST 5% for fruit and vegetables Dehydrated products.</span>
        {% endif %}
      </div>

      {% if pdp_variant.inventory_quantity > 0 and pdp_variant.inventory_quantity <= 10 %}
        <div class="product-stock-alert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span>Only {{ pdp_variant.inventory_quantity }} left in stock!</span>
        </div>
      {% endif %}

      {% form 'product', product, class: 'product-form', id: 'product-form' %}
        <span data-product-config data-gst5="{% if product.tags contains 'gst-5' %}true{% else %}false{% endif %}" data-currency="{{ cart.currency.symbol | escape }}" style="display:none" aria-hidden="true"></span>
        {% if product.variants.size > 1 %}
          <script type="application/json" id="product-variants-data">
            {
              "options": {{ product.options | json }},
              "variants": {{ product.variants | json }},
              "defaultVariantId": {{ pdp_variant.id | json }}
            }
          </script>
        {% endif %}

        {% if product.variants.size > 1 %}
          <div class="product-variants">
            {% for option in product.options_with_values %}
              {% liquid
                assign option_name_down = option.name | downcase
                assign variant_grid_class = 'variant-options-grid pack-grid'
                unless option_name_down contains 'weight' or option_name_down contains 'size'
                  assign variant_grid_class = 'variant-options-grid'
                endunless
                assign option_index = forloop.index0
              %}
              <div class="variant-option">
                <label class="variant-label pack-label">{{ section.settings.pack_label | default: 'Choose Pack Size' }}</label>
                <div class="{{ variant_grid_class }}">
                  {% for value in option.values %}
                    {% liquid
                      assign variant_for_value = nil
                      if option_index == 0
                        assign variant_for_value = product.variants | where: 'option1', value | first
                      elsif option_index == 1
                        assign variant_for_value = product.variants | where: 'option2', value | first
                      else
                        assign variant_for_value = product.variants | where: 'option3', value | first
                      endif
                      assign weight_subtitle = variant_for_value.metafields.custom.weight_subtitle.value
                      if weight_subtitle == blank
                        assign weight_subtitle = variant_for_value.metafields.custom.weight_subtitle
                      endif
                      assign supply_duration = variant_for_value.metafields.custom.supply_duration.value
                      if supply_duration == blank
                        assign supply_duration = variant_for_value.metafields.custom.supply_duration
                      endif
                      assign value_down = value | downcase
                      if supply_duration == blank
                        if value_down contains '150'
                          assign supply_duration = '18–21 day supply'
                        elsif value_down contains '300'
                          assign supply_duration = '43-day supply'
                        elsif value_down contains '450'
                          assign supply_duration = '64-day supply'
                        endif
                      endif
                      assign is_recommended_variant = false
                      if variant_for_value != blank
                        assign recommended_flag = variant_for_value.metafields.custom.variant_recommended.value
                        if recommended_flag == blank
                          assign recommended_flag = variant_for_value.metafields.custom.variant_recommended
                        endif
                        if recommended_flag == true
                          assign is_recommended_variant = true
                        endif
                      endif
                      assign pack_ribbon_text = ''
                      assign pack_ribbon_modifier = ''
                      if value_down contains '150'
                        assign pack_ribbon_text = section.settings.trial_ribbon_text | default: 'Trial Pack'
                      elsif value_down contains '300'
                        assign pack_ribbon_text = section.settings.offer_ribbon_text | default: 'Buy 2 · 10% Off'
                        assign pack_ribbon_modifier = 'offer'
                      elsif value_down contains '450'
                        assign pack_ribbon_text = section.settings.bundle_ribbon_text | default: 'Buy 2 · Free 150g'
                        assign pack_ribbon_modifier = 'offer'
                      elsif is_recommended_variant
                        assign pack_ribbon_text = section.settings.best_value_ribbon_text | default: '★ Best Value'
                      endif
                    %}
                    <button
                      type="button"
                      class="variant-option-btn pack-btn{% if is_recommended_variant %} best-value{% endif %}{% if variant_for_value.id == pdp_variant.id %} active{% endif %}"
                      data-option="{{ option.name }}"
                      data-value="{{ value }}"
                      {% if variant_for_value %}
                        data-variant-id="{{ variant_for_value.id }}"
                        data-price="{{ variant_for_value.price }}"
                        data-compare-price="{{ variant_for_value.compare_at_price }}"
                        data-supply="{{ supply_duration | escape }}"
                      {% endif %}
                      {% if variant_for_value == blank %}
                        disabled
                      {% else %}
                        {% unless variant_for_value.available %}
                          disabled
                        {% endunless %}
                      {% endif %}
                    >
                      {% if pack_ribbon_text != blank %}
                        <span class="pack-ribbon{% if pack_ribbon_modifier != blank %} {{ pack_ribbon_modifier }}{% endif %}">{{ pack_ribbon_text }}</span>
                      {% endif %}
                      <span class="pack-btn__body">
                        <span class="pack-btn__main">
                          <span class="pack-size">{{ value }}</span>
                          {% if weight_subtitle != blank %}
                            <span class="pack-name">{{ weight_subtitle }}</span>
                          {% endif %}
                        </span>
                        <span class="pack-btn__pricing">
                          {% if variant_for_value != blank and variant_for_value.compare_at_price > variant_for_value.price %}
                            <span class="pack-mrp">{{ variant_for_value.compare_at_price | money }}</span>
                          {% endif %}
                          {% if variant_for_value != blank %}
                            <span class="pack-price">{{ variant_for_value.price | money }}</span>
                          {% endif %}
                        </span>
                      </span>
                      {% if variant_for_value != blank %}
                        {% unless variant_for_value.available %}
                          <span class="variant-unavailable">Sold out</span>
                        {% endunless %}
                      {% endif %}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
            <select name="id" id="product-variant-select" class="variant-select-hidden" data-variant-select>
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant.id == pdp_variant.id %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                  data-price="{{ variant.price }}"
                  data-compare-price="{{ variant.compare_at_price }}"
                  data-inventory="{{ variant.inventory_quantity }}"
                >
                  {{ variant.title }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ pdp_variant.id }}">
        {% endif %}

        <div id="upgrade-text-templates" hidden aria-hidden="true">
          {% for variant in product.variants %}
            {% assign variant_upgrade_plain = variant.metafields.custom.upgradetext | metafield_text | strip %}
            {% if variant_upgrade_plain != blank %}
              <template id="upgrade-text-{{ variant.id }}">
                {{ variant.metafields.custom.upgradetext | metafield_tag }}
              </template>
            {% endif %}
          {% endfor %}
          {% assign product_upgrade_plain = product.metafields.custom.upgradetext | metafield_text | strip %}
          {% if product_upgrade_plain != blank %}
            <template id="upgrade-text-product">
              {{ product.metafields.custom.upgradetext | metafield_tag }}
            </template>
          {% endif %}
        </div>

        <div class="info-badge" id="pgramExplainer"{% unless pdp_has_upgrade_text %} data-fallback="true"{% endunless %}>
          {% if pdp_has_upgrade_text %}
            {{ pdp_upgrade_field | metafield_tag }}
          {% else %}
            <strong>Good for trying {{ product.title | split: ' ' | first }} for the first time.</strong>
            <div class="info-tip">Most customers who start small come back for a larger pack within a few weeks.</div>
          {% endif %}
        </div>

        {% capture combo_offers_markup %}
          {% render 'combo-offers-inline' %}
        {% endcapture %}
        {% assign combo_offers_markup = combo_offers_markup | strip %}
        {% if combo_offers_markup != blank %}
          <div class="combo-offers-inline">{{ combo_offers_markup }}</div>
        {% endif %}

        <div class="qty-row">
          <span class="qty-label">Qty:</span>
          <div class="quantity-selector">
            <button type="button" class="quantity-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
            <input type="number" id="quantity-select" name="quantity" value="1" min="1" max="10" class="quantity-input" readonly>
            <button type="button" class="quantity-btn" data-action="increase" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <button
          type="submit"
          name="add"
          class="cta-button cta-button--primary btn-atc"
          id="add-to-cart-btn"
          {% unless pdp_variant.available %}disabled{% endunless %}
        >
          <span class="cta-button__text">
            {% if pdp_variant.available %}
              Add to Cart — <span class="atc-price" id="atcPrice">{{ pdp_variant.price | money }}</span>
            {% else %}
              Sold Out
            {% endif %}
          </span>
        </button>

        {% if pdp_variant.available %}
          <div class="product-buy-now-blocks">
            {% for block in section.blocks %}
              <div class="product-buy-now-block" {{ block.shopify_attributes }}>
                {% case block.type %}
                  {% when 'buy_now_button' %}
                    {% render 'gokwik-buy-now' %}
                  {% when '@app' %}
                    {% render block %}
                {% endcase %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      {% endform %}

      {% assign amazon_link_metafield = product.metafields.custom.amazon_link %}
      {% if amazon_link_metafield != blank %}
        {% if amazon_link_metafield.value.url != blank %}
          {% assign amazon_url = amazon_link_metafield.value.url %}
        {% elsif amazon_link_metafield.value != blank %}
          {% assign amazon_url = amazon_link_metafield.value | strip %}
        {% endif %}
        {% if amazon_url != blank %}
          <a
            href="{{ amazon_url }}"
            target="_blank"
            rel="noopener noreferrer"
            class="cta-button cta-button--secondary cta-button--amazon"
            aria-label="Buy On Amazon"
          >
            <span class="cta-button__text">Buy On Amazon</span>
          </a>
        {% endif %}
      {% endif %}

      <div class="trust-row" aria-label="Trust highlights">
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">🚚</div>
          <strong>Free Shipping</strong>
          On orders ₹499+
        </div>
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">🔒</div>
          <strong>Secure Pay</strong>
          SSL encrypted
        </div>
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">⚡</div>
          <strong>Ships in 24h</strong>
          Fast dispatch
        </div>
        <div class="trust-item">
          <div class="trust-icon" aria-hidden="true">🧪</div>
          <strong>Lab Tested</strong>
          3rd party verified
        </div>
      </div>
    </div>
  </div>
</section>


<!-- Product Description Section -->
{% if product and product.description != blank %}
  <section class="product-description-section" id="product-description">
    <div class="product-description-section__container">
      <div class="pdp-description-shell">
        <button
          type="button"
          class="pdp-description-shell__toggle"
          id="pdp-description-toggle"
          aria-expanded="false"
          aria-controls="pdp-description-panel"
        >
          <span class="pdp-description-shell__toggle-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3l7 4v10l-7 4-7-4V7l7-4z"/>
              <path d="M12 9v6M9 12h6"/>
            </svg>
          </span>
          <span class="pdp-description-shell__toggle-copy">
            <span class="pdp-description-shell__eyebrow">Inside this pack</span>
            <span class="pdp-description-shell__title">Product deep dive</span>
          </span>
          <span class="pdp-description-shell__toggle-action" aria-hidden="true">View detail</span>
        </button>
        <div
          class="pdp-description-shell__panel"
          id="pdp-description-panel"
          role="region"
          aria-labelledby="pdp-description-toggle"
          hidden
        >
          <div class="pdp-description-layout">
            <div class="pdp-description-layout__content">
              <h2 class="pdp-description-layout__heading">Why this product works</h2>
              <div class="pdp-description-prose">
                {{ product.description }}
              </div>
            </div>
            <aside class="pdp-description-layout__rail" aria-label="Product highlights">
              <div class="pdp-description-quickfacts">
                <p class="pdp-description-quickfacts__title">Quick highlights</p>
                <ul class="pdp-description-quickfacts__list">
                  {% if product.tags.size > 0 %}
                    {% for tag in product.tags limit: 4 %}
                      <li>{{ tag | replace: '-', ' ' }}</li>
                    {% endfor %}
                  {% else %}
                    <li>Clean ingredients profile</li>
                    <li>Fits daily wellness routine</li>
                    <li>Simple preparation format</li>
                    <li>Shipped fresh from source</li>
                  {% endif %}
                </ul>
                <a href="#product-ingredients-nutrition" class="pdp-description-quickfacts__link">See nutrition panel</a>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}

<!-- Sticky Add to Cart Bar (Mobile) -->
<div class="sticky-cart-bar" id="sticky-cart-bar">
  <div class="sticky-cart-bar__content">
    <div class="sticky-cart-bar__info">
      <div class="sticky-cart-bar__image">
        {% if product.featured_image %}
          <img 
            src="{{ product.featured_image | image_url: width: 80 }}" 
            srcset="
              {{ product.featured_image | image_url: width: 80 }} 80w,
              {{ product.featured_image | image_url: width: 160 }} 160w
            "
            sizes="60px"
            alt="{{ product.title }}" 
            width="80" 
            height="80"
            loading="lazy"
            onerror="this.classList.add('image-error'); this.alt='Image failed to load';"
          >
        {% endif %}
      </div>
      <div class="sticky-cart-bar__details">
        <div class="sticky-cart-bar__title">{{ product.title | truncate: 40 }}</div>
        <div class="sticky-cart-bar__price">
          {% if pdp_variant.compare_at_price > pdp_variant.price %}
            <span class="price-old">{{ pdp_variant.compare_at_price | money }}</span>
          {% endif %}
          <span class="price-current">{{ pdp_variant.price | money }}</span>
        </div>
      </div>
    </div>
    <button type="submit" form="product-form" name="add" class="sticky-cart-bar__button" id="sticky-add-to-cart" {% unless pdp_variant.available %}disabled{% endunless %}>
      Add to Cart
    </button>
  </div>
</div>

{% stylesheet %}
  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in-up {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Main Container */
  .product-hero {
    width: 100%;
    max-width: 100%;
    padding: 0 32px 60px;
    background: var(--white);
    box-sizing: border-box;
  }

  .product-hero__container {
    max-width: 1160px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(0, 480px);
    gap: 40px;
    justify-content: center;
  }

  /* Product Gallery */
  .product-gallery {
    position: sticky;
    top: 80px;
    height: fit-content;
    min-width: 0;
    max-width: 640px;
    width: 100%;
  }

  .product-image-main {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background: #f5f9f2;
    margin-bottom: 12px;
    border: 1px solid #e0ddd7;
  }

  .product-image-main__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .product-image-main__img.image-error {
    opacity: 0.5;
    background: rgba(245, 245, 245, 0.8);
  }

  .sticky-cart-bar__image img.image-error {
    opacity: 0.5;
    background: rgba(245, 245, 245, 0.8);
  }

  .gallery-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    letter-spacing: 0.3px;
    z-index: 2;
    pointer-events: none;
  }

  .gallery-badge--promo {
    background: #c0186a;
    color: #fff;
  }

  #product-image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  #product-image-lightbox .product-lightbox-inner {
    max-width: 90vw;
    max-height: 90vh;
    max-height: 90dvh;
    position: relative;
  }

  #product-image-lightbox .product-lightbox-img {
    max-width: 100%;
    max-height: 90vh;
    max-height: 90dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  #product-image-lightbox .product-lightbox-close {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
    width: 48px;
    height: 48px;
    border: none;
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    z-index: 10;
  }

  #product-image-lightbox .product-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #product-image-lightbox .product-lightbox-prev {
    left: max(12px, env(safe-area-inset-left));
  }

  #product-image-lightbox .product-lightbox-next {
    right: max(12px, env(safe-area-inset-right));
  }

  #product-image-lightbox .product-lightbox-counter {
    position: absolute;
    bottom: max(20px, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
    font-weight: 500;
    z-index: 10;
    pointer-events: none;
  }

  .product-image-zoom {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .product-image-zoom:hover {
    background: var(--white);
    transform: scale(1.1);
  }

  .product-thumbnails-wrap {
    position: relative;
    max-width: 100%;
    min-width: 0;
  }

  .product-thumbnails {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    margin-top: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 2px 0;
  }

  .product-thumbnails::-webkit-scrollbar {
    display: none;
  }

  .product-thumbnails-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.12);
    color: var(--forest-green);
    cursor: pointer;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .product-thumbnails-nav[hidden] {
    display: none;
  }

  .product-thumbnails-prev {
    left: -6px;
  }

  .product-thumbnails-next {
    right: -6px;
  }

  .product-thumbnail {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    scroll-snap-align: start;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    background: var(--bg);
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .product-thumbnail:hover {
    opacity: 0.88;
  }

  .product-thumbnail.is-active {
    border-color: var(--forest-green, #2d5016);
    box-shadow: 0 0 0 1px var(--forest-green, #2d5016);
  }

  .product-thumbnail__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* Product Info */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 4px;
    min-width: 0;
    max-width: 480px;
    width: 100%;
  }

  .product-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 4px;
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--forest-green);
    font-weight: 500;
  }

  .trust-badge svg {
    flex-shrink: 0;
  }

  .trust-badge--shipping {
    background: linear-gradient(135deg, rgba(74, 124, 44, 0.12) 0%, rgba(74, 124, 44, 0.06) 100%);
    color: var(--forest-green);
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(74, 124, 44, 0.25);
    font-weight: 600;
  }

  .trust-badge--high-demand {
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.12) 0%, rgba(220, 38, 38, 0.06) 100%);
    color: #b91c1c;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid rgba(220, 38, 38, 0.25);
    font-weight: 600;
  }

  .product-eyebrow,
  .pdp-tag {
    display: none;
  }

  /* Product Title */
  .product-title {
    font-size: 30px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0;
    color: var(--forest-green);
    font-family: var(--font-heading);
    letter-spacing: -0.5px;
  }

  /* Rating Summary */
  .product-rating-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: -8px;
  }

  .rating-stars {
    display: flex;
    gap: 2px;
    color: #c8952a;
  }

  .rating-text {
    font-size: 14px;
    color: rgba(26, 26, 26, 0.7);
  }

  .rating-link {
    color: var(--forest-green);
    text-decoration: none;
  }

  .rating-link:hover {
    text-decoration: underline;
  }

  /* Price Section */
  .product-price-section.price-block {
    display: block;
    background: #f5f9f2;
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 4px;
    border: 1px solid #d4e8c2;
  }

  .price-was {
    font-size: 13px;
    color: rgba(26, 26, 26, 0.55);
    text-decoration: line-through;
    margin-bottom: 4px;
  }

  .price-now {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .price-main {
    font-size: 36px;
    font-weight: 700;
    color: var(--forest-green);
    font-family: var(--font-heading);
    line-height: 1;
  }

  .price-save-pill {
    background: #c0186a;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
  }

  .price-note {
    font-size: 12px;
    color: rgba(26, 26, 26, 0.55);
  }

  .price-original,
  .price-current,
  .price-label,
  .price-value,
  .price-savings,
  .price-gst {
    display: none;
  }

  .price-gst-note {
    display: block;
    font-size: 12px;
    color: var(--forest-green);
    font-weight: 700;
    margin-top: 6px;
    padding: 6px 12px;
    background: rgba(74, 124, 44, 0.08);
    border-radius: 4px;
    border-left: 3px solid var(--sage-green);
  }

  /* Stock Alert */
  .product-stock-alert,
  .product-stock-available {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .product-stock-alert {
    background: rgba(255, 87, 34, 0.1);
    color: var(--forest-green);
  }

  .product-stock-available {
    background: rgba(220, 38, 38, 0.1);
    color: #b91c1c;
  }

  /* Variants */
  .product-variants {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .variant-option {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .variant-label,
  .pack-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0;
  }

  .variant-options-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .variant-options-grid.pack-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
  }

  .variant-option-btn.pack-btn {
    position: relative;
    border: 2px solid var(--border-color);
    border-radius: 12px;
    padding: 12px 10px 10px;
    cursor: pointer;
    background: #fff;
    transition: border-color 0.18s, box-shadow 0.18s;
    text-align: center;
    user-select: none;
    min-height: auto;
    display: block;
    width: 100%;
  }

  .variant-option-btn.pack-btn:hover:not(:disabled):not(.active) {
    border-color: #3d6b1e;
    background: #fff;
    color: inherit;
  }

  .variant-option-btn.pack-btn.active {
    border-color: var(--forest-green);
    background: #f5f9f2;
    box-shadow: 0 0 0 3px rgba(45, 80, 22, 0.1);
    color: inherit;
  }

  .variant-option-btn.pack-btn.best-value {
    border-color: var(--forest-green);
  }

  .pack-ribbon {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--forest-green);
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 2px 10px;
    border-radius: 20px;
    white-space: nowrap;
    text-transform: uppercase;
    pointer-events: none;
  }

  .pack-ribbon.offer {
    background: #b07d12;
  }

  .pack-btn__body,
  .pack-btn__main,
  .pack-btn__pricing {
    display: block;
  }

  .pack-size {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    line-height: 1;
  }

  .pack-name {
    display: block;
    font-size: 10px;
    color: rgba(26, 26, 26, 0.55);
    margin: 3px 0 6px;
    font-weight: 400;
  }

  .pack-mrp {
    display: block;
    font-size: 11px;
    color: rgba(26, 26, 26, 0.55);
    text-decoration: line-through;
    margin-bottom: 2px;
  }

  .pack-price {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--forest-green);
  }

  .variant-option-btn__title,
  .variant-option-btn__subtitle,
  .variant-option-btn__badge {
    display: none;
  }

  .variant-option-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .variant-unavailable {
    display: block;
    font-size: 11px;
    margin-top: 2px;
    font-weight: 600;
    opacity: 0.85;
  }

  .info-badge {
    background: #f5f9f2;
    border: 1px solid #c8e0ad;
    border-left: 3px solid var(--forest-green);
    border-radius: 12px;
    padding: 10px 12px;
    margin: 4px 0 0;
    font-size: 11px;
    line-height: 1.45;
    color: rgba(26, 26, 26, 0.65);
  }

  .info-badge strong {
    color: var(--forest-green);
    font-size: inherit;
    font-weight: 600;
  }

  .info-badge .metafield-rich_text_field {
    font-size: inherit;
    line-height: inherit;
  }

  .info-badge .metafield-rich_text_field > :first-child {
    margin-top: 0;
  }

  .info-badge .metafield-rich_text_field > :last-child {
    margin-bottom: 0;
  }

  .info-badge .metafield-rich_text_field p,
  .info-badge .metafield-rich_text_field li,
  .info-badge .metafield-rich_text_field span {
    font-size: inherit;
    line-height: inherit;
  }

  .info-badge .metafield-rich_text_field p {
    margin: 0 0 6px;
    color: rgba(26, 26, 26, 0.65);
  }

  .info-badge .metafield-rich_text_field p:last-child {
    margin-bottom: 0;
  }

  .info-badge .metafield-rich_text_field p strong {
    color: var(--forest-green);
    font-size: inherit;
  }

  .info-badge .info-tip {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-top: 6px;
    font-size: inherit;
    color: rgba(26, 26, 26, 0.65);
  }

  .info-badge .info-tip::before {
    content: "💡";
    flex-shrink: 0;
  }

  .offer-banner {
    background: linear-gradient(135deg, #fff8e7 0%, #fdf0cc 100%);
    border: 1.5px solid #c8952a;
    border-radius: 12px;
    padding: 11px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .combo-offers-inline {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
  }

  .combo-offer-banner {
    border-color: var(--combo-offer-accent, #c8952a);
  }

  .combo-offer-banner .offer-banner__text strong {
    color: var(--combo-offer-accent, #b07d10);
  }

  .combo-offer-banner .offer-banner__tag {
    background: var(--combo-offer-accent, #c8952a);
  }

  .offer-banner__icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .offer-banner__text {
    line-height: 1.45;
    color: rgba(26, 26, 26, 0.65);
  }

  .offer-banner__text strong {
    color: #b07d10;
    font-weight: 700;
  }

  .offer-banner__how-to-claim {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    line-height: 1.4;
    color: rgba(26, 26, 26, 0.55);
  }

  .offer-banner__tag {
    display: inline-block;
    background: #c8952a;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 10px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    margin-left: 4px;
    vertical-align: middle;
  }

  .variant-select-hidden {
    display: none;
  }

  /* Product Form */
  .product-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .qty-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 0;
  }

  .qty-label {
    font-size: 13px;
    font-weight: 500;
    color: rgba(26, 26, 26, 0.65);
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--border-color);
    border-radius: 6px;
    width: fit-content;
    overflow: hidden;
  }

  .quantity-btn {
    width: 36px;
    height: 36px;
    border: none;
    background: #faf8f4;
    font-size: 18px;
    font-weight: 300;
    cursor: pointer;
    transition: background 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .quantity-btn:hover {
    background: rgba(74, 124, 44, 0.1);
  }

  .quantity-input {
    width: 44px;
    height: 36px;
    border: none;
    border-left: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    -moz-appearance: textfield;
  }

  .quantity-input::-webkit-outer-spin-button,
  .quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cta-button {
    width: 100%;
    padding: 16px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-transform: none;
    letter-spacing: 0;
    font-family: inherit;
  }

  .cta-button--primary,
  .btn-atc {
    background: var(--forest-green);
    color: #fff;
    margin-bottom: 0;
  }

  .cta-button--primary:hover:not(:disabled),
  .btn-atc:hover:not(:disabled) {
    background: #3d6b1e;
    transform: none;
    box-shadow: none;
  }

  .cta-button--primary:active:not(:disabled),
  .btn-atc:active:not(:disabled) {
    transform: scale(0.99);
  }

  .cta-button--secondary {
    background: #fff;
    color: var(--forest-green);
    border: 2px solid var(--forest-green);
    margin-top: 0;
  }

  .cta-button--secondary:hover {
    background: #f5f9f2;
  }

  .atc-price {
    font-size: 18px;
    opacity: 0.9;
  }

  .cta-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* CTA as link (e.g. Buy on Amazon) - reset link styles so it looks like a button */
  a.cta-button {
    text-decoration: none;
    box-sizing: border-box;
    -webkit-appearance: none;
    appearance: none;
  }

  a.cta-button--secondary {
    background: transparent;
    color: var(--forest-green);
    border: 2px solid var(--forest-green);
    margin-top: 8px;
  }

  a.cta-button--secondary:hover {
    background: rgba(74, 124, 44, 0.05);
    color: var(--forest-green);
  }

  .product-buy-now-blocks {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 0.75rem;
    margin-top: 8px;
  }

  .product-buy-now-block {
    width: 100%;
  }

  /* Make any Buy Now block (theme/app) match Add-to-Cart width */
  .product-buy-now-blocks :is(button, a, input[type="button"], input[type="submit"]) {
    width: 100% !important;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    background: #fff !important;
    color: var(--forest-green) !important;
    border: 2px solid var(--forest-green) !important;
    border-radius: 12px !important;
    padding: 13px !important;
    font-size: 15px !important;
    font-weight: 600 !important;
  }

  .trust-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 4px;
  }

  .trust-item {
    text-align: center;
    font-size: 11px;
    color: rgba(26, 26, 26, 0.55);
    line-height: 1.4;
  }

  .trust-icon {
    font-size: 18px;
    margin-bottom: 3px;
  }

  .trust-item strong {
    display: block;
    color: var(--text);
    font-size: 11px;
  }

  /* Product Description Section */
  .product-description-section {
    width: 100%;
    max-width: 100%;
    padding: 30px 40px;
    background: linear-gradient(135deg, rgba(45, 80, 22, 0.02) 0%, rgba(74, 124, 44, 0.04) 50%, rgba(255, 255, 255, 0.02) 100%);
    box-sizing: border-box;
  }

  .product-description-section__container {
    max-width: 1200px;
    margin: 0 auto;
