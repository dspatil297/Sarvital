    }

    .trust-row {
      grid-template-columns: repeat(2, 1fr);
    }

    .sticky-cart-bar {
      display: flex;
      align-items: center;
      padding: 10px 20px;
      padding-bottom: max(10px, env(safe-area-inset-bottom));
    }

    .sticky-cart-bar__content {
      padding-left: 0;
      padding-right: 0;
      width: 100%;
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }

    .sticky-cart-bar__info {
      flex: 1;
      min-width: 0;
    }

    .sticky-cart-bar__image {
      width: 52px;
