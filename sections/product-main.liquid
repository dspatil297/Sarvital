  .pdp-description-quickfacts__list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    font-size: 14px;
    color: rgba(26, 26, 26, 0.84);
  }

  .pdp-description-quickfacts__link {
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--forest-green);
    font-size: 14px;
    font-weight: 600;
  }

  .pdp-description-quickfacts__link:hover {
    color: var(--sage-green);
  }

  /* Sticky Cart Bar (Mobile) */
  .sticky-cart-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--white);
    border-top: 1px solid var(--border-color);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
    z-index: 1000;
    display: none;
    padding: 12px 20px;
