  .pdp-description-shell__eyebrow {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(45, 80, 22, 0.72);
    font-weight: 700;
  }

  .pdp-description-shell__title {
    font-size: 24px;
    line-height: 1.2;
    color: var(--text);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .pdp-description-shell__toggle-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 14px;
    border-radius: 999px;
    background: rgba(74, 124, 44, 0.14);
    color: var(--forest-green);
    font-size: 13px;
    line-height: 1;
    font-weight: 700;
    flex-shrink: 0;
  }

  .pdp-description-shell__toggle[aria-expanded='true'] .pdp-description-shell__toggle-action {
    background: rgba(45, 80, 22, 0.2);
  }

  .pdp-description-shell__panel {
    padding: 20px 24px 24px;
  }

  .pdp-description-shell__panel[hidden] {
    display: none !important;
    padding: 0;
    border: 0;
  }

  .pdp-description-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(260px, 0.85fr);
