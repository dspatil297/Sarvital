        pointer-events: none;
      }
    </style>
    <script>
      (function() {
        var lightboxPrevLabel = {{ 'products.media.previous_image' | t | json }};
        var lightboxNextLabel = {{ 'products.media.next_image' | t | json }};
        var lightboxCloseLabel = {{ 'products.media.close_zoom' | t | json }};
        var lightboxDialogLabel = {{ 'products.media.zoomed_gallery' | t | json }};
        var lightboxCounterTemplate = {{ 'products.media.image_counter' | t: index: '__INDEX__', count: '__COUNT__' | json }};

        function openLightbox(src, alt, index, images) {
          var existing = document.getElementById('product-image-lightbox');
          if (existing && existing.parentNode) existing.parentNode.removeChild(existing);

          var gallery = images && images.length ? images : [{ src: src, alt: alt || '' }];
          var currentIndex = typeof index === 'number' ? index : 0;
          currentIndex = Math.max(0, Math.min(currentIndex, gallery.length - 1));
          var hasMultiple = gallery.length > 1;

          var overlay = document.createElement('div');
          overlay.id = 'product-image-lightbox';
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-modal', 'true');
          overlay.setAttribute('aria-label', lightboxDialogLabel);

          var html = '<button type="button" class="product-lightbox-close" aria-label="' + lightboxCloseLabel + '">&times;</button>';
          if (hasMultiple) {
            html += '<button type="button" class="product-lightbox-nav product-lightbox-prev" aria-label="' + lightboxPrevLabel + '">&#8249;</button>';
            html += '<button type="button" class="product-lightbox-nav product-lightbox-next" aria-label="' + lightboxNextLabel + '">&#8250;</button>';
            html += '<div class="product-lightbox-counter" aria-live="polite"></div>';
          }
          html += '<div class="product-lightbox-inner"><img src="" alt="" class="product-lightbox-img"></div>';
          overlay.innerHTML = html;

          var im = overlay.querySelector('.product-lightbox-img');
          var counterEl = overlay.querySelector('.product-lightbox-counter');
          var prevBtn = overlay.querySelector('.product-lightbox-prev');
          var nextBtn = overlay.querySelector('.product-lightbox-next');

          function updateCounter() {
            if (!counterEl) return;
            counterEl.textContent = lightboxCounterTemplate
              .replace('__INDEX__', String(currentIndex + 1))
              .replace('__COUNT__', String(gallery.length));
          }

          function showAt(nextIndex) {
            currentIndex = (nextIndex + gallery.length) % gallery.length;
            var item = gallery[currentIndex];
            im.src = item.src;
            im.alt = item.alt || '';
            updateCounter();
            if (window.productImageGallery && typeof window.productImageGallery.goTo === 'function') {
              window.productImageGallery.goTo(currentIndex);
            }
          }

          showAt(currentIndex);
          document.body.appendChild(overlay);
          if (window.lockBodyScroll) window.lockBodyScroll();
          else document.body.style.overflow = 'hidden';

          function closeLightbox() {
            if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
            if (window.unlockBodyScroll) window.unlockBodyScroll();
            else document.body.style.overflow = '';
            document.removeEventListener('keydown', onKey);
          }

          function onKey(ev) {
            if (ev.key === 'Escape') closeLightbox();
            else if (hasMultiple && ev.key === 'ArrowLeft') showAt(currentIndex - 1);
            else if (hasMultiple && ev.key === 'ArrowRight') showAt(currentIndex + 1);
          }

          overlay.addEventListener('click', function(ev) {
            if (ev.target === overlay || ev.target.classList.contains('product-lightbox-close')) closeLightbox();
          });
          if (prevBtn) prevBtn.addEventListener('click', function(ev) { ev.stopPropagation(); showAt(currentIndex - 1); });
          if (nextBtn) nextBtn.addEventListener('click', function(ev) { ev.stopPropagation(); showAt(currentIndex + 1); });

          var touchStartX = 0;
          overlay.addEventListener('touchstart', function(ev) {
            if (ev.touches.length) touchStartX = ev.touches[0].clientX;
          }, { passive: true });
          overlay.addEventListener('touchend', function(ev) {
            if (!hasMultiple || !ev.changedTouches || !ev.changedTouches.length) return;
            var diff = touchStartX - ev.changedTouches[0].clientX;
            if (diff > 50) showAt(currentIndex + 1);
            else if (diff < -50) showAt(currentIndex - 1);
          }, { passive: true });

          document.addEventListener('keydown', onKey);
        }

        window.openProductImageLightbox = window.openProductImageLightbox || openLightbox;

        document.addEventListener('product-zoom-image', function(e) {
          if (!e.detail || !e.detail.src) return;
          var openFn = window.openProductImageLightbox || openLightbox;
          openFn(e.detail.src, e.detail.alt || '', e.detail.index, e.detail.images);
        });
      })();
    </script>
    {% endif %}

    {% render 'deferred-scripts' %}

    {%- comment -%} WebMCP: defer until idle — not needed for storefront paint or LCP {%- endcomment -%}
    <script>
    (function() {
      function initWebMcp() {
      if (!navigator.modelContext || typeof navigator.modelContext.registerTool !== 'function') return;
      var controller = new AbortController();
      var origin = {{ request.origin | json }};

      navigator.modelContext.registerTool({
        name: 'search_products',
        description: 'Search Sarvital product catalog for natural superfood powders (moringa, amla, sattu). Returns matching products with titles, prices, and URLs.',
        inputSchema: {
          type: 'object',
          properties: {
            query: { type: 'string', description: 'Search query, e.g. "moringa powder" or "immunity"' }
          },
          required: ['query']
        },
        execute: function(args) {
          return fetch(origin + '/search/suggest.json?q=' + encodeURIComponent(args.query) + '&resources[type]=product&resources[limit]=6')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var items = (data.resources && data.resources.results && data.resources.results.products) || [];
              return items.map(function(p) {
                return { title: p.title, price: p.price, url: origin + p.url, image: p.image };
              });
            });
        },
        signal: controller.signal
      });

      navigator.modelContext.registerTool({
        name: 'get_cart',
        description: 'Retrieve the current Sarvital shopping cart contents, item count, and total price.',
        inputSchema: { type: 'object', properties: {} },
        execute: function() {
          return fetch(origin + '/cart.js').then(function(r) { return r.json(); });
        },
        signal: controller.signal
      });

      navigator.modelContext.registerTool({
        name: 'get_product',
        description: 'Get full details for a Sarvital product by its handle (slug). Returns title, description, price, variants, and images.',
        inputSchema: {
          type: 'object',
          properties: {
            handle: { type: 'string', description: 'Product handle/slug, e.g. "moringa-powder"' }
          },
          required: ['handle']
        },
        execute: function(args) {
          return fetch(origin + '/products/' + encodeURIComponent(args.handle) + '.json')
            .then(function(r) { return r.json(); })
            .then(function(data) { return data.product; });
        },
        signal: controller.signal
      });

      navigator.modelContext.registerTool({
        name: 'list_collections',
        description: 'List all Sarvital product collections.',
        inputSchema: { type: 'object', properties: {} },
        execute: function() {
          return fetch(origin + '/collections.json').then(function(r) { return r.json(); });
        },
        signal: controller.signal
      });

      window.addEventListener('beforeunload', function() { controller.abort(); });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initWebMcp, { timeout: 8000 });
      } else {
        window.addEventListener('load', function() { setTimeout(initWebMcp, 3000); });
      }
    })();
    </script>
  </body>
</html>
