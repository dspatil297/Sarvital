{%- comment -%}
  Enhanced SEO Meta Tags
  Includes: Title, Description, Open Graph, Twitter Cards, Canonical URLs
{%- endcomment -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin | append: request.path
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = page_image | default: shop.brand.logo | default: shop.brand.image
  assign seo_description = page_description | default: og_description | strip_html | truncate: 160
  assign default_og_image_url = 'Logo.png' | asset_url | prepend: 'https:'

  if request.page_type == 'index' and page_description == blank and shop.description != blank
    assign seo_description = shop.description | strip_html | truncate: 160
    assign og_description = shop.description
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
    assign og_image = product.featured_image | default: og_image
    if page_description != blank
      assign og_description = page_description
    else
      assign og_description = product.description | strip_html | truncatewords: 25 | default: og_description
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    assign og_image = article.image | default: og_image
    assign og_description = article.excerpt | default: article.content | strip_html | truncatewords: 25 | default: og_description
  elsif request.page_type == 'collection'
    assign og_image = collection.featured_image | default: og_image
    assign og_description = collection.description | strip_html | truncatewords: 25 | default: og_description
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign seo_brand_name = 'Sarvital'
  assign seo_title = page_title
  assign shop_title_suffix = ' – ' | append: shop.name
  if seo_title contains shop.name
    assign seo_title = seo_title | remove: shop_title_suffix | strip
  endif
  assign page_title_lower = seo_title | downcase
  assign title_has_brand = false
  if page_title_lower contains 'sarvital'
    assign title_has_brand = true
  endif
-%}

{%- comment -%} Primary Meta Tags (charset/viewport live in layout/theme.liquid for early discovery) {%- endcomment -%}
<meta name="theme-color" content="#2d5016">
<meta name="format-detection" content="telephone=no">

{%- comment -%} Title Tag {%- endcomment -%}
<title>
  {{- seo_title -}}
  {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t }}: {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t }} {{ current_page }}{% endif -%}
  {%- unless title_has_brand %} &ndash; {{ seo_brand_name }}{% endunless -%}
</title>

{%- comment -%} Meta Description {%- endcomment -%}
{% if seo_description != blank %}
  <meta name="description" content="{{ seo_description | escape_once }}">
{% endif %}

{%- comment -%} Canonical URL {%- endcomment -%}
<link rel="canonical" href="{{ canonical_url }}">

{%- comment -%} Open Graph Tags {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | escape | truncate: 200 }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- else -%}
  <meta property="og:image" content="{{ default_og_image_url }}">
  <meta property="og:image:secure_url" content="{{ default_og_image_url }}">
  <meta property="og:image:alt" content="{{ shop.name | escape }}">
{%- endif -%}

{%- comment -%} Product-specific Open Graph {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  {%- if product.available -%}
    <meta property="product:availability" content="in stock">
  {%- else -%}
    <meta property="product:availability" content="out of stock">
  {%- endif -%}
  {%- if product.variants.first.sku != blank -%}
    <meta property="product:retailer_item_id" content="{{ product.variants.first.sku }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%} Twitter Card Tags {%- endcomment -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape | truncate: 200 }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta name="twitter:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- else -%}
  <meta name="twitter:image" content="{{ default_og_image_url }}">
  <meta name="twitter:image:alt" content="{{ shop.name | escape }}">
{%- endif -%}
{%- if shop.social_networks.twitter -%}
  <meta name="twitter:site" content="@{{ shop.social_networks.twitter | remove: '@' }}">
{%- endif -%}

{%- comment -%} Additional SEO Meta Tags {%- endcomment -%}
{%- liquid
  if request.page_type == 'password' or request.page_type == '404'
    assign robots_content = 'noindex,nofollow'
  else
    assign robots_content = 'index,follow'
  endif
-%}
<meta name="robots" content="{{ robots_content }}">
<meta name="googlebot" content="{{ robots_content }}">
<meta name="author" content="{{ shop.name | escape }}">

{%- comment -%} Structured Data (JSON-LD) {%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- liquid
    assign schema_variant = product.selected_or_first_available_variant
    assign schema_description = product.description | strip_html | truncatewords: 120
    if schema_description == blank
      assign schema_description = product.title
    endif
    assign review_rating = product.metafields.reviews.rating.value | default: product.metafields.reviews.rating
    assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
    assign review_count_num = review_count | plus: 0
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ schema_description | json }},
      "url": {{ shop.url | append: product.url | json }},
      "image": [
        {%- for image in product.images limit: 5 -%}
          "https:{{ image | image_url: width: 1200 }}"{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": "{{ schema_variant.price | money_without_currency | strip_html }}",
        "availability": "https://schema.org/{% if schema_variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": {
          "@type": "Organization",
          "name": {{ shop.name | json }}
        }
      }
      {%- if schema_variant.sku != blank -%}
      ,"sku": {{ schema_variant.sku | json }}
      {%- endif -%}
      {%- if schema_variant.barcode != blank -%}
      ,"gtin": {{ schema_variant.barcode | json }}
      {%- endif -%}
      {%- if review_rating != blank and review_count_num > 0 -%}
      ,"aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ review_rating | json }},
        "reviewCount": {{ review_count_num | json }}
      }
      {%- endif -%}
    }
  </script>
{%- elsif request.page_type == 'index' -%}
  {%- assign homepage_schema_description = page_description | default: shop.description | default: og_description | strip_html | truncate: 160 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "WebPage",
      "name": {{ page_title | default: shop.name | json }},
      "description": {{ homepage_schema_description | json }},
      "url": {{ shop.url | json }},
      "isPartOf": {
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      }
    }
  </script>
{%- elsif request.page_type == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "description": {{ collection.description | strip_html | truncatewords: 50 | json }},
      "url": {{ shop.url | append: collection.url | json }}
    }
  </script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Article",
      "headline": {{ article.title | json }},
      "description": {{ article.excerpt | default: article.content | strip_html | truncatewords: 50 | json }},
      "image": {% if article.image %}"https:{{ article.image | image_url: width: 1200 }}"{% else %}[]{% endif %},
      "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "logo": {
          "@type": "ImageObject",
          "url": "https:{{ shop.brand.logo | image_url: width: 200 }}"
        }
      }
    }
  </script>
{%- endif -%}

{%- comment -%} Organization Schema {%- endcomment -%}
{%- liquid
  assign org_same_as = ''
  if shop.social_networks.facebook != blank
    assign org_same_as = org_same_as | append: shop.social_networks.facebook | append: '||'
  endif
  if shop.social_networks.twitter != blank
    assign org_same_as = org_same_as | append: shop.social_networks.twitter | append: '||'
  endif
  if shop.social_networks.instagram != blank
    assign org_same_as = org_same_as | append: shop.social_networks.instagram | append: '||'
  endif
  if shop.social_networks.pinterest != blank
    assign org_same_as = org_same_as | append: shop.social_networks.pinterest | append: '||'
  endif
  assign org_same_as_links = org_same_as | split: '||'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "logo": "https:{{ shop.brand.logo | default: shop.brand.image | image_url: width: 200 }}",
    "description": {{ shop.description | default: 'Premium natural fruit & vegetable powders. Lab-tested, sustainably sourced, and packed with natural goodness.' | json }}
    {%- if org_same_as != blank -%}
    ,"sameAs": [
      {%- assign first_social_link = true -%}
      {%- for social_url in org_same_as_links -%}
        {%- if social_url != blank -%}
          {%- unless first_social_link -%},{%- endunless -%}{{ social_url | json }}
          {%- assign first_social_link = false -%}
        {%- endif -%}
      {%- endfor -%}
    ]
    {%- endif -%}
    ,"contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": {{ shop.email | json }}
    }
  }
</script>

{%- comment -%} Website Schema {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
</script>

{%- comment -%} Breadcrumb Schema {%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if request.page_type == 'product' -%}
          {%- if collection -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ shop.url | append: collection.url | json }}
            }
          {%- endif -%}
          ,{
            "@type": "ListItem",
            "position": {% if collection %}3{% else %}2{% endif %},
            "name": {{ product.title | json }},
            "item": {{ shop.url | append: product.url | json }}
          }
        {%- elsif request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          }
        {%- elsif request.page_type == 'article' -%}
          {%- if blog -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ shop.url | append: blog.url | json }}
            }
          {%- endif -%}
          ,{
            "@type": "ListItem",
            "position": {% if blog %}3{% else %}2{% endif %},
            "name": {{ article.title | json }},
            "item": {{ shop.url | append: article.url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
