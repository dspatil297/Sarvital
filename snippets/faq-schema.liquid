{% doc %}
  Renders FAQPage JSON-LD from parsed Q/A pairs (GEO/AEO structured answers).

  @param {array} faq_items - Array of strings formatted as `question|||answer`

  @example
  {% render 'faq-schema', faq_items: faq_items %}
{% enddoc %}

{% if faq_items.size > 0 %}
  {% assign faq_schema_entries = 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in faq_items -%}
          {%- assign qa_parts = item | split: '|||' -%}
          {%- assign faq_question = qa_parts[0] | strip -%}
          {%- assign faq_answer = qa_parts[1] | strip | strip_html | strip_newlines -%}
          {%- if faq_question != blank and faq_answer != blank -%}
            {%- if faq_schema_entries > 0 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ faq_question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq_answer | json }}
              }
            }
            {%- assign faq_schema_entries = faq_schema_entries | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{% endif %}
