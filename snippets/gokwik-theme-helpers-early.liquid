{% doc %}
  Early GoKwik theme helpers: hide theme cart drawer and keep it closed before deferred scripts load.

  @example
  {% render 'gokwik-theme-helpers-early' %}
{% enddoc %}

<style>
  #cart-drawer {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }
  [id*="kwik"],
  [id*="Kwik"],
  [class*="kwik-cart"],
  [class*="KwikCart"],
  [class*="gokwik"],
  [class*="slide-cart"] {
    z-index: 999999 !important;
  }
</style>
<script>
(function () {
  function keepThemeCartClosed() {
    var el = document.getElementById('cart-drawer');
    if (el) {
      el.classList.remove('active');
      el.setAttribute('aria-hidden', 'true');
      el.style.setProperty('display', 'none', 'important');
    }
  }
  keepThemeCartClosed();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', keepThemeCartClosed);
  }
})();
</script>
